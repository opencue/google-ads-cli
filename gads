def cmd_health(args):
    customer = args.customer

    # Account
    res = api_call("POST", "googleAds:search", {"query":
        "SELECT customer.id, customer.descriptive_name, customer.currency_code, "
        "customer.time_zone, customer.optimization_score FROM customer"}, customer)
    cust = res["results"][0]["customer"] if res.get("results") else {}

    # Campaigns + 7d perf
    end_d = datetime.date.today() - datetime.timedelta(days=1)
    start_d = end_d - datetime.timedelta(days=6)
    res = api_call("POST", "googleAds:search", {"query": f"""
        SELECT campaign.id, campaign.status,
               campaign.advertising_channel_type,
               metrics.cost_micros, metrics.clicks, metrics.conversions
        FROM campaign WHERE segments.date BETWEEN '{start_d}' AND '{end_d}'
          AND campaign.status != 'REMOVED'
    """}, customer)
    campaign_rows = res.get("results", [])
    by_status = {}
    total_cost, total_clicks, total_conv = 0, 0, 0.0
    for row in campaign_rows:
        c = row["campaign"]
        by_status[c["status"]] = by_status.get(c["status"], 0) + 1
        m = row.get("metrics", {})
        total_cost += int(m.get("costMicros", 0))
        total_clicks += int(m.get("clicks", 0))
        total_conv += float(m.get("conversions", 0))

    # Account-level assets
    res = api_call("POST", "googleAds:search", {"query":
        "SELECT customer_asset.field_type FROM customer_asset "
        "WHERE customer_asset.status != 'REMOVED'"}, customer)
    asset_counts = {}
    for row in res.get("results", []):
        ft = row["customerAsset"]["fieldType"]
        asset_counts[ft] = asset_counts.get(ft, 0) + 1

    # Asset groups
    res = api_call("POST", "googleAds:search", {"query":
        "SELECT asset_group.ad_strength FROM asset_group "
        "WHERE asset_group.status != 'REMOVED'"}, customer)
    ag_strength = {}
    for row in res.get("results", []):
        s = row["assetGroup"].get("adStrength", "UNKNOWN")
        ag_strength[s] = ag_strength.get(s, 0) + 1

    # Snapshot + audit pointers
    snaps = _snapshot_list()
    latest_snap = snaps[0].stem if snaps else None
    audit_path = _audit_log_path()
    last_audit = None
    if audit_path.exists():
        lines = audit_path.read_text(encoding="utf-8").splitlines()
        if lines:
            try:
                last_audit = json.loads(lines[-1])
            except Exception:
                pass

    payload = {
        "customer_id": cust.get("id"),
        "descriptive_name": cust.get("descriptiveName"),
        "currency": cust.get("currencyCode"),
        "time_zone": cust.get("timeZone"),
        "optimization_score": float(cust.get("optimizationScore", 0)),
        "campaigns_by_status": by_status,
        "perf_7d": {
            "cost_units": total_cost / 1_000_000,
            "clicks": total_clicks,
            "conversions": total_conv,
        },
        "account_assets": asset_counts,
        "asset_groups_by_strength": ag_strength,
        "latest_snapshot": latest_snap,
        "last_audit_entry": last_audit,
    }

    if args.format == "json":
        _emit_json(payload)
        return

    name = payload["descriptive_name"] or "(unnamed)"
    print(f"╔═ {name}  ({customer}) ═══════════════════════════════════════════╗")
    print(f"  Currency:           {payload['currency']}   ·   TZ: {payload['time_zone']}")
    score = payload["optimization_score"] * 100
    score_glyph = "✓" if score >= 70 else ("⚠" if score >= 40 else "✗")
    print(f"  Optimization Score: {score_glyph} {score:.0f}%   (target: 70%+)")
    print()
    print(f"  Campaigns:  " + ", ".join(f"{k}={v}" for k, v in by_status.items()) or "  none")
    p = payload["perf_7d"]
    print(f"  Last 7 days: {p['cost_units']:,.0f} spend  ·  {p['clicks']:,} clicks  ·  {p['conversions']:.1f} conv")
    print()
    print(f"  Account assets: " + (", ".join(f"{k}={v}" for k, v in asset_counts.items()) or "(none)"))
    print(f"  Asset groups:   " + (", ".join(f"{k}={v}" for k, v in ag_strength.items()) or "(none)"))
    print()
    if latest_snap:
        print(f"  Latest snapshot: {latest_snap}")
    if last_audit:
        print(f"  Last mutation:   {last_audit.get('ts')}  {last_audit.get('command')}")
    print(f"╚═════════════════════════════════════════════════════════════════════╝")
    print()
    print(f"Run `gads suggest` for prioritized fix recommendations.")


# ─── Snapshots: save / list / diff / restore ──────────────────────────────
#
# A snapshot is just an export TOML written to ~/.gads/snapshots/. They
# auto-save before every --apply mutation so you have a rollback path.
# Restore is the same code path as `sync` — a snapshot file IS a state file.

_MUTATING_COMMANDS = {
    "delete-conversion", "disable-url-expansion", "enable-url-expansion",
    "set-bid", "set-budget", "set-status",
    "add-sitelink", "add-callout", "add-snippet", "seed-account-assets",
    "add-text-assets", "add-business-name", "upload-image", "add-youtube-video",
    "replace-headlines", "create-brand-campaign", "split-asset-group",
    "cleanup-orphans", "sync",
}


def _snapshot_dir():
    d = Path.home() / ".gads" / "snapshots"
    d.mkdir(parents=True, exist_ok=True)
    return d


def _make_snapshot(customer_id, label=None, silent=False):
    """Capture current state to ~/.gads/snapshots/<ts>[-<label>].toml.
    Returns the snapshot Path."""
    state = {
        "account": {"customer_id": customer_id},
        "campaigns": _live_campaigns_state(customer_id),
    }
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    safe_label = "".join(c if c.isalnum() or c in "-_" else "_" for c in (label or ""))
    name = f"{ts}-{safe_label}.toml" if safe_label else f"{ts}.toml"
    path = _snapshot_dir() / name
    path.write_text(_serialize_state_toml(state))
    if not silent:
        print(f"  📸 snapshot: {path.name}  ({len(state['campaigns'])} campaign(s))")
    return path


def _snapshot_list():
    """Returns list of Path objects sorted newest-first."""
    return sorted(_snapshot_dir().glob("*.toml"), reverse=True)


def _resolve_snapshot(arg):
    """Resolve a snapshot reference: full filename, label suffix, or `latest`."""
    snapshots = _snapshot_list()
    if not snapshots:
        sys.exit("ERROR: no snapshots found in ~/.gads/snapshots/")
    if arg == "latest":
        return snapshots[0]
    # Exact match (stem or filename)
    for s in snapshots:
        if s.stem == arg or s.name == arg:
            return s
    # Suffix / substring match
    matches = [s for s in snapshots if arg in s.stem]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        sys.exit(f"ERROR: no snapshot matches '{arg}'. Run `gads snapshot list`.")
    sys.exit(f"ERROR: ambiguous '{arg}' matches {len(matches)} snapshots: "
             + ", ".join(s.name for s in matches[:5]))


def cmd_snapshot_save(args):
    _make_snapshot(args.customer, args.label, silent=False)


def cmd_snapshot_list(args):
    snapshots = _snapshot_list()
    if args.format == "json":
        out = []
        for s in snapshots:
            stat = s.stat()
            out.append({
                "name": s.stem,
                "path": str(s),
                "size_bytes": stat.st_size,
                "mtime": datetime.datetime.fromtimestamp(stat.st_mtime).isoformat(),
            })
        _emit_json(out)
        return
    if not snapshots:
        print(f"No snapshots yet. Take one: gads snapshot save [<label>]")
        return
    print(f"{'NAME':<40}  {'SIZE':>7}  WHEN")
    print("-" * 100)
    for s in snapshots:
        stat = s.stat()
        when = datetime.datetime.fromtimestamp(stat.st_mtime).strftime("%Y-%m-%d %H:%M")
        print(f"{s.stem:<40}  {stat.st_size:>6}B  {when}")


def cmd_snapshot_show(args):
    path = _resolve_snapshot(args.snapshot)
    sys.stdout.write(path.read_text())


def cmd_snapshot_diff(args):
    path = _resolve_snapshot(args.snapshot)
    if args.format != "json":
        print(f"Diffing snapshot {path.name} vs live (customer {args.customer})...\n")
    # Re-use the sync diff machinery — snapshot is the same TOML format
    snapshot_state = _load_state_file(path)
    changes = _compute_diff(snapshot_state, args.customer)
    if args.format == "json":
        _emit_json({"snapshot": path.name, "changes": changes})
        return
    if not changes:
        print("✓ No drift — live account matches this snapshot.")
        return
    print(f"{len(changes)} difference(s) (live vs snapshot):\n")
    for ch in changes:
        if ch["field"] in ("_missing_in_live", "_only_in_live"):
            print(f"  ⚠  {ch['field']}: campaign {ch['campaign_id']} '{ch['name']}'")
        else:
            print(f"  ~  '{ch['name']}' [{ch['campaign_id']}]")
            print(f"        {ch['field']}: live={ch['current']!r}  snapshot={ch['desired']!r}")
    print(f"\nRestore: gads snapshot restore {path.stem} --apply")


def cmd_snapshot_restore(args):
    path = _resolve_snapshot(args.snapshot)
    # Just call sync with the snapshot as the state file
    args.state_file = str(path)
    cmd_sync(args)


# ─── Orphan cleanup ───────────────────────────────────────────────────────

def _orphan_budgets(customer_id):
    """Return list of (budget_id, name) for campaign budgets with no
    non-removed campaign referencing them (reference_count == 0)."""
    q = """
    SELECT
      campaign_budget.id, campaign_budget.name,
      campaign_budget.reference_count, campaign_budget.amount_micros
    FROM campaign_budget
    WHERE campaign_budget.status != 'REMOVED'
    """
    res = api_call("POST", "googleAds:search", {"query": q}, customer_id)
    out = []
    for row in res.get("results", []):
        cb = row["campaignBudget"]
        # reference_count comes back as a string in REST JSON
        if int(cb.get("referenceCount", "0")) == 0:
            out.append((cb["id"], cb.get("name", "(unnamed)"), int(cb.get("amountMicros", "0"))))
    return out


def _orphan_text_assets(customer_id, limit=500):
    """Return list of (asset_id, text) for TEXT assets with no current
    asset_group_asset, customer_asset, or campaign_asset link."""
    # Pull all live assets of type TEXT
    q_assets = f"""
    SELECT asset.id, asset.text_asset.text
    FROM asset
    WHERE asset.type = 'TEXT'
    LIMIT {limit}
    """
    res = api_call("POST", "googleAds:search", {"query": q_assets}, customer_id)
    all_text = {row["asset"]["id"]: row["asset"]["textAsset"]["text"]
                for row in res.get("results", [])}
    if not all_text:
        return []

    # Pull live linked-asset IDs across the three link tables
    linked = set()
    for resource in ("asset_group_asset", "customer_asset", "campaign_asset"):
        q = f"""
        SELECT asset.id
        FROM {resource}
        WHERE {resource}.status != 'REMOVED'
        """
        try:
            res = api_call("POST", "googleAds:search", {"query": q}, customer_id)
            for row in res.get("results", []):
                linked.add(row["asset"]["id"])
        except SystemExit:
            # Some link resources require extra fields; ignore and proceed
            pass

    return [(aid, text) for aid, text in all_text.items() if aid not in linked]


def cmd_cleanup_orphans(args):
    target = args.type.lower()
    if target not in ("budget", "asset", "all"):
        sys.exit(f"ERROR: --type must be one of: budget, asset, all")

    budgets, assets = [], []
    if target in ("budget", "all"):
        if args.format != "json":
            print("Scanning for orphan campaign budgets...")
        budgets = _orphan_budgets(args.customer)
        if args.format != "json":
            print(f"  Found {len(budgets)} orphan budget(s).\n")
            for bid, name, micros in budgets:
                print(f"    {bid}  {micros_to_units(micros):>10} /day  {name}")

    if target in ("asset", "all"):
        if args.format != "json":
            print("\nScanning for orphan text assets...")
        assets = _orphan_text_assets(args.customer)
        if args.format != "json":
            print(f"  Found {len(assets)} orphan text asset(s).\n")
            for aid, text in assets[:50]:
                preview = text[:60] + ("..." if len(text) > 60 else "")
                print(f"    {aid:>14}  {preview}")
            if len(assets) > 50:
                print(f"    ... and {len(assets) - 50} more")
            if assets:
                print("\n  ⚠️  This scan checks asset_group_asset, customer_asset, and")
                print("      campaign_asset link tables. Text assets used inside RSA")
                print("      headlines/descriptions are linked via ad_group_ad_asset_view")
                print("      and may show as orphan here even though Google references")
                print("      them. If you see RSA copy in this list, the API will refuse")
                print("      to delete an in-use asset (RESOURCE_IN_USE) — safe to try.")

    if args.format == "json":
        _emit_json({
            "orphan_budgets": [{"id": b[0], "name": b[1], "daily_units": b[2]/1_000_000} for b in budgets],
            "orphan_text_assets": [{"id": a[0], "text": a[1]} for a in assets],
            "apply": args.apply,
        })
        if not args.apply:
            return

    total = len(budgets) + len(assets)
    if total == 0:
        if args.format != "json":
            print("\n✓ No orphans found.")
        return

    if not args.apply:
        dry_run_banner(f"DELETE {len(budgets)} budget(s) + {len(assets)} asset(s)", str(args.customer))
        return

    print(f"\nDeleting {total} orphan resource(s)...")
    if budgets:
        ops = [{"remove": f"customers/{args.customer}/campaignBudgets/{b[0]}"} for b in budgets]
        api_call("POST", "campaignBudgets:mutate", {"operations": ops}, args.customer)
        print(f"  ✓ {len(budgets)} budget(s) deleted")

    if assets:
        # Delete in batches of 100 to stay under API operation limits
        for i in range(0, len(assets), 100):
            batch = assets[i:i+100]
            ops = [{"remove": f"customers/{args.customer}/assets/{a[0]}"} for a in batch]
            api_call("POST", "assets:mutate", {"operations": ops}, args.customer)
        print(f"  ✓ {len(assets)} asset(s) deleted")

    print("\nDone. Re-run `gads cleanup-orphans` to verify.")


