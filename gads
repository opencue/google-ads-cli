# Headline packs are loaded from brand TOMLs in gads-packs/brands/<name>.toml.
# Each brand TOML has a `headlines = [...]` array.


def _current_headlines(asset_group_id, customer_id):
    """Return list of {asset_id, text} dicts for HEADLINE-type assets in the group."""
    q = f"""
    SELECT
      asset.id, asset.text_asset.text,
      asset_group_asset.field_type, asset_group_asset.status
    FROM asset_group_asset
    WHERE asset_group.id = {asset_group_id}
      AND asset_group_asset.field_type = 'HEADLINE'
      AND asset_group_asset.status != 'REMOVED'
    """
    res = api_call("POST", "googleAds:search", {"query": q}, customer_id)
    return [
        {"asset_id": row["asset"]["id"], "text": row["asset"]["textAsset"]["text"]}
        for row in res.get("results", [])
    ]


def _google_width(s):
    """Google Ads counts en-dash/em-dash/minus/wide chars as 2 each, not 1
    like Python len(). Approximation: any char outside basic Latin counts as
    1 unless it's one of the known wide-glyph dashes."""
    wide = {"–", "—", "−"}  # en-dash, em-dash, minus sign
    return sum(2 if c in wide else 1 for c in s)


def cmd_replace_headlines(args):
    pack = _load_pack(args.pack, _load_profile(args.profile))
    new_headlines = pack.get("headlines") or []
    if not new_headlines:
        sys.exit(f"ERROR: pack '{args.pack}' nem tartalmaz 'headlines' tömböt")
    pack_name = pack.get("name", args.pack)

    for h in new_headlines:
        w = _google_width(h)
        if w > 30:
            sys.exit(f"ERROR: '{h}' Google-width {w} > 30 max (en-dash/minus chars-ot ASCII '-'-re)")

    existing = _current_headlines(args.asset_group_id, args.customer)
    keep_n = max(0, 15 - len(new_headlines))  # Google max is 15 headlines per group
    to_remove_n = max(0, len(existing) - keep_n)

    print(f"Asset group {args.asset_group_id} — pack: {pack_name.upper()}\n")
    print(f"  Jelenlegi headlines: {len(existing)}")
    for i, h in enumerate(existing):
        marker = "✗ remove" if i < to_remove_n else "✓ keep  "
        print(f"    {marker}  [{h['asset_id']}]  {h['text']}")

    print(f"\n  Új headlines: {len(new_headlines)}")
    for h in new_headlines:
        print(f"    + ({len(h):>2} kar)  {h}")

    final_count = (len(existing) - to_remove_n) + len(new_headlines)
    print(f"\n  Végállapot: {final_count} headline (Google max: 15)")
    if final_count > 15:
        sys.exit("ERROR: végállapot > 15, ami a Google limit. Csökkents.")

    if not args.apply:
        dry_run_banner(f"REPLACE HEADLINES pack={pack_name}", str(args.asset_group_id))
        return

    print("\nLépés 1/2: új text asset-ek létrehozása...")
    asset_create_ops = [
        {"create": {"textAsset": {"text": h}}} for h in new_headlines
    ]
    res = api_call("POST", "assets:mutate", {"operations": asset_create_ops}, args.customer)
    new_asset_resources = [r["resourceName"] for r in res["results"]]
    print(f"  ✓ {len(new_asset_resources)} text asset létrehozva")

    print("\nLépés 2/2: asset group linkek (atomic remove + add)...")
    asset_group_resource = f"customers/{args.customer}/assetGroups/{args.asset_group_id}"
    ops = []
    for h in existing[:to_remove_n]:
        remove_rn = f"customers/{args.customer}/assetGroupAssets/{args.asset_group_id}~{h['asset_id']}~HEADLINE"
        ops.append({"remove": remove_rn})
    for asset_rn in new_asset_resources:
        ops.append({"create": {
            "assetGroup": asset_group_resource,
            "asset": asset_rn,
            "fieldType": "HEADLINE",
        }})
    api_call("POST", "assetGroupAssets:mutate", {"operations": ops}, args.customer)
    print(f"  ✓ {to_remove_n} régi headline eltávolítva, {len(new_asset_resources)} új linkelve\n")
    print(f"Kész. Ellenőrzés: gads list-assets {args.asset_group_id}")


