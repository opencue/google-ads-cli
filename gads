    s = args.strategy
    update = {"resourceName": resource}

    if s == "TARGET_CPA":
        if not args.target:
            sys.exit("ERROR: --target required (CPA value in account currency, e.g. 5000)")
        update["targetCpa"] = {"targetCpaMicros": int(float(args.target) * 1_000_000)}
        mask = "target_cpa"
    elif s == "TARGET_ROAS":
        if not args.target:
            sys.exit("ERROR: --target kell (ROAS multiplier, pl. 4.0)")
        update["targetRoas"] = {"targetRoas": float(args.target)}
        mask = "target_roas"
    elif s == "MAXIMIZE_CONVERSIONS":
        update["maximizeConversions"] = {}
        mask = "maximize_conversions"
    elif s == "MAXIMIZE_CONVERSION_VALUE":
        update["maximizeConversionValue"] = {}
        mask = "maximize_conversion_value"
    else:
        sys.exit(f"ERROR: nem támogatott strategy: {s}")

    body = {"operations": [{"update": update, "updateMask": mask}]}
    if not args.apply:
        dry_run_banner(f"BID STRATEGY → {s}" + (f" target={args.target}" if args.target else ""), resource)
