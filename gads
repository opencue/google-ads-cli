#!/usr/bin/env python3
"""gads — portable Google Ads CLI

Auth: GOOGLE_ADS_DEVELOPER_TOKEN env var + `gcloud auth application-default
print-access-token`. Pick the account via --profile <name> (preferred),
GADS_PROFILE env var, default_profile in ~/.config/gads/config.toml, or
explicit --customer <id>.

Profiles live in ~/.config/gads/profiles/<name>.toml and define customer_id,
locale, packs_root, etc. Bulk commands consume per-account TOML packs.

All mutating commands run as DRY-RUN by default. Add --apply to commit.

Commands (read-only):
  list-profiles                               List configured profiles
  list-campaigns                              Active campaigns + budget + bid strategy
  list-conversions                            Conversion actions
  list-assets <asset_group_id>                Assets in an asset group
  list-account-assets                         Account-level sitelinks/callouts/snippets
  list-adgroups [--campaign ID] [--status ENABLED]
  list-keywords [--campaign ID] [--ad-group ID] [--status ENABLED]
  list-recommendations                        Pending Google recommendations
  stats [--days N | --start YYYY-MM-DD --end YYYY-MM-DD] [--campaign ID]
  stats-vs-prev --days N [--campaign ID]      Delta vs prior N days
  gaql "<query>"                              Run any GAQL query

Commands (mutating — dry-run unless --apply):
  delete-conversion <id> [--apply]
  disable-url-expansion <campaign_id> [--apply]   PMAX URL expansion OFF
  enable-url-expansion <campaign_id> [--apply]    PMAX URL expansion ON
  set-bid <campaign_id> --strategy <S> [--target <X>] [--apply]
      S ∈ {TARGET_CPA, TARGET_ROAS, MAXIMIZE_CONVERSIONS, MAXIMIZE_CONVERSION_VALUE}
  set-budget <campaign_id> --daily <amount> [--apply]    daily budget in account currency
  set-status <resource_type> <id> {ENABLED|PAUSED} [--apply]
      resource_type ∈ {campaign, ad_group, asset_group}

  add-sitelink <text> <url> [--d1 <s>] [--d2 <s>] [--apply]
  add-callout <text> [--apply]
  add-snippet <header> <v1> <v2> <v3>... [--apply]   header must be a Google enum
  seed-account-assets --pack <file> [--apply]        bulk sitelinks/callouts/snippets

  add-text-assets <ag_id> --field-type {HEADLINE|DESCRIPTION|LONG_HEADLINE|BUSINESS_NAME} "<t1>"... [--apply]
  add-business-name <ag_id> <name> [--apply]
  upload-image <ag_id> <file> --field-type <ft> [--name <s>] [--apply]
  add-youtube-video <ag_id> <video_id_or_url> [--name <s>] [--apply]

  replace-headlines <asset_group_id> --pack <file> [--apply]
      Atomic remove old + add new headlines from a brand pack TOML
  create-brand-campaign --pack <file> [--apply]
      Full Search campaign (budget + geo + ad group + keywords + RSA), PAUSED on create
  split-asset-group <source_ag> --brand-packs <p1,p2,p3> [--apply]
      Spawn N new asset groups from brand pack TOMLs (images copied from source)

Examples:
  gads list-profiles
  gads list-campaigns
  gads stats --days 30
  gads stats-vs-prev --days 14
  gads delete-conversion <conversion_id> --apply
  gads set-budget <campaign_id> --daily 5000 --apply
  gads set-status campaign <campaign_id> ENABLED --apply
"""

