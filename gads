def _prompt(prompt_text, default=None, required=False, validator=None):
    """Tiny readline-free prompt. validator(value) -> (ok, error_msg|None)."""
    label = f"{prompt_text}" + (f" [{default}]" if default else "") + ": "
    while True:
        try:
            v = input(label).strip()
        except (EOFError, KeyboardInterrupt):
            print("\nAborted.")
            sys.exit(1)
        if not v and default is not None:
            v = default
        if not v and required:
            print("  → required, please answer.")
            continue
        if validator and v:
            ok, msg = validator(v)
            if not ok:
                print(f"  → {msg}")
                continue
        return v


def cmd_init(args):
    """Interactive wizard to create a profile + default config + packs dir."""
    print("Welcome to gads. Let's set up your first profile.\n")

    def _name_ok(v): return (v.replace("-", "").replace("_", "").isalnum(), "use letters/digits/-/_ only")
    def _cid_ok(v):  return (v.isdigit() and 9 <= len(v) <= 11, "customer_id must be 9-11 digits (no hyphens)")

    name = _prompt("Profile name", required=True, validator=_name_ok)
    profile_path = _GADS_CONFIG_DIR / "profiles" / f"{name}.toml"
    if profile_path.exists():
        ans = _prompt(f"Profile '{name}' already exists. Overwrite? (y/N)", default="N")
        if ans.lower() not in ("y", "yes"):
            print("Aborted.")
            return

    customer_id = _prompt("Customer ID (from Ads UI top-right, 10 digits, no hyphens)",
                          required=True, validator=_cid_ok)
    login_id = _prompt("Login (MCC) customer ID — leave blank if not under an MCC")
    if login_id and not (login_id.isdigit() and 9 <= len(login_id) <= 11):
        sys.exit("ERROR: login_customer_id must be 9-11 digits if provided.")

    brand_name = _prompt("Brand name (e.g. ACME Tires)")
    homepage   = _prompt("Brand homepage URL (e.g. https://www.example.com/)")
    language   = _prompt("Language code", default="en")
    currency   = _prompt("Currency code", default="USD")
    geo_str    = _prompt("Geo target ID(s) comma-separated (US=2840, UK=2826, HU=2348)",
                          default="2840")
    geo_targets = [int(g.strip()) for g in geo_str.split(",") if g.strip().isdigit()]

    default_packs = str(Path.home() / "gads-packs" / name)
    packs_root = _prompt("Packs root path", default=default_packs)
    Path(packs_root).mkdir(parents=True, exist_ok=True)

    today = datetime.date.today().isoformat()
    lines = [
        f"# Generated by `gads init` on {today}",
        "",
        f'customer_id = "{customer_id}"',
    ]
    if login_id:
        lines.append(f'login_customer_id = "{login_id}"')
    lines += [
        f'packs_root = "{packs_root}"',
        "",
        "[brand]",
        f'name = "{brand_name}"',
        f'homepage = "{homepage}"',
        "",
        "[locale]",
        f'language = "{language}"',
        f'currency = "{currency}"',
        f"geo_targets = {geo_targets}",
        "",
        "[defaults]",
        'campaign_status_on_create = "PAUSED"',
        "url_check_before_apply = true",
        "",
    ]
    profile_path.parent.mkdir(parents=True, exist_ok=True)
    profile_path.write_text("\n".join(lines))
    print(f"\n✓ Wrote {profile_path}")

    cfg_path = _GADS_CONFIG_DIR / "config.toml"
    cfg_path.write_text(f'default_profile = "{name}"\n')
    print(f"✓ Set '{name}' as default profile")
    print(f"✓ Created packs dir: {packs_root}")

    print("\nNext steps:")
    print(f"  1. export GOOGLE_ADS_DEVELOPER_TOKEN=<your_token>     # if not yet")
    print(f"  2. gads auth check                                     # verify auth")
    print(f"  3. gads list-campaigns                                 # confirm API access")
    print(f"  4. Copy example packs:")
    print(f"     cp -r examples/packs/* {packs_root}/")


def cmd_auth_check(args):
    """Preflight: verify dev token, gcloud ADC, and (optionally) customer access."""
    print("Checking gads auth setup...\n")
    ok = True

    # 1. Dev token env var
    token = os.environ.get("GOOGLE_ADS_DEVELOPER_TOKEN", "").strip()
    if token:
        masked = f"{token[:4]}…{token[-4:]}" if len(token) > 8 else "(short)"
        print(f"  ✓ GOOGLE_ADS_DEVELOPER_TOKEN set ({len(token)} chars, {masked})")
    else:
        print("  ✗ GOOGLE_ADS_DEVELOPER_TOKEN env var not set")
        print("    → Apply for a dev token: https://ads.google.com/aw/apicenter")
        print("    → export GOOGLE_ADS_DEVELOPER_TOKEN=<your-token>")
        ok = False

    # 2. ADC token
    try:
        result = subprocess.run(
            ["gcloud", "auth", "application-default", "print-access-token"],
            capture_output=True, text=True, check=True, timeout=10,
        )
        if result.stdout.strip():
            print("  ✓ gcloud ADC token retrievable")
        else:
            print("  ✗ gcloud ADC token is empty")
            ok = False
    except subprocess.CalledProcessError as e:
        print("  ✗ gcloud ADC not configured")
        print(f"    stderr: {(e.stderr or '').strip()[:200]}")
        print("    → gcloud auth application-default login \\")
        print("         --scopes=https://www.googleapis.com/auth/adwords,https://www.googleapis.com/auth/cloud-platform")
        ok = False
    except FileNotFoundError:
        print("  ✗ gcloud not installed or not on PATH")
        print("    → Install: https://cloud.google.com/sdk/docs/install")
        ok = False

    # 3. Profile + customer accessibility
    profile = _load_profile(getattr(args, "profile", None))
    if profile:
        print(f"  ✓ Profile '{profile.get('_name')}' loaded (customer_id={profile.get('customer_id')})")
    else:
        print("  ⚠ No profile configured. Run `gads init` to set one up.")

    if ok and profile and not args.skip_customer:
        try:
            cid = profile.get("customer_id")
            res = api_call("POST", "googleAds:search",
                           {"query": "SELECT customer.id, customer.descriptive_name FROM customer"},
                           cid)
            results = res.get("results", [])
