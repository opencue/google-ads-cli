# ─── Asset group splitting: 1 mixed group → N brand-focused groups ────────

# Brand group config is loaded from per-brand TOML files at runtime.
# Pass --brand-packs <pack1,pack2,pack3> to split-asset-group; each pack
# defines name, final_url, headlines, descriptions, long_headlines.


def _existing_image_assets(source_asset_group_id, customer_id):
    """Returns list of (asset_resource_name, field_type) for all IMAGE assets
    in a source asset group — for copying to new groups."""
    q = f"""
    SELECT asset.id, asset.resource_name, asset.type, asset_group_asset.field_type
    FROM asset_group_asset
    WHERE asset_group.id = {source_asset_group_id}
      AND asset_group_asset.status != 'REMOVED'
      AND asset.type = 'IMAGE'
    """
    res = api_call("POST", "googleAds:search", {"query": q}, customer_id)
    return [
        (row["asset"]["resourceName"], row["assetGroupAsset"]["fieldType"])
        for row in res.get("results", [])
    ]


def cmd_split_asset_group(args):
    profile = _load_profile(args.profile)
    pack_paths = [p.strip() for p in args.brand_packs.split(",") if p.strip()]
    if not pack_paths:
        sys.exit("ERROR: --brand-packs needs at least 1 pack (comma-separated)")
    brands = []
    for pp in pack_paths:
        cfg = _load_pack(pp, profile)
        for key in ("name", "asset_group_name", "final_url", "headlines",
                    "descriptions", "long_headlines"):
            if not cfg.get(key):
                sys.exit(f"ERROR: pack '{pp}' missing required field '{key}'")
        for h in cfg["headlines"]:
            if _google_width(h) > 30:
                sys.exit(f"ERROR: [{cfg['name']}] headline '{h}' Google-width > 30")
        for d in cfg["descriptions"]:
            if _google_width(d) > 90:
                sys.exit(f"ERROR: [{cfg['name']}] description '{d}' Google-width > 90")
        for lh in cfg["long_headlines"]:
            if _google_width(lh) > 90:
                sys.exit(f"ERROR: [{cfg['name']}] long headline '{lh}' Google-width > 90")
        brands.append(cfg)

    campaign_id = _campaign_for_asset_group(args.source_group, args.customer)
    print(f"Source asset group: {args.source_group}")
    print(f"Parent campaign:    {campaign_id}")
    print(f"New asset groups ({len(brands)}):\n")
    for cfg in brands:
        print(f"  {cfg['asset_group_name']}")
        print(f"    Final URL:       {cfg['final_url']}")
        print(f"    Headlines:       {len(cfg['headlines'])}")
        print(f"    Descriptions:    {len(cfg['descriptions'])}")
        print(f"    Long headlines:  {len(cfg['long_headlines'])}")

    source_images = _existing_image_assets(args.source_group, args.customer)
    print(f"\n  Images copied from source ({len(source_images)}): {', '.join(set(ft for _, ft in source_images))}")

    if not args.apply:
        dry_run_banner(f"SPLIT INTO {len(brands)} asset group", "+".join(c["name"] for c in brands))
        print("\nNote: the source asset group is NOT deleted or paused — handle that yourself in the UI.")
        return

    campaign_rn = f"customers/{args.customer}/campaigns/{campaign_id}"

    for cfg in brands:
        print(f"\n══ Brand: {cfg['name'].upper()} ══")

        print(f"  [1/4] Creating asset group...")
        ag_op = {"create": {
            "campaign": campaign_rn,
            "name": cfg["asset_group_name"],
            "finalUrls": [cfg["final_url"]],
            "status": "PAUSED",
        }}
        res = api_call("POST", "assetGroups:mutate", {"operations": [ag_op]}, args.customer)
        ag_rn = res["results"][0]["resourceName"]
        ag_id = ag_rn.rsplit("/", 1)[-1]
        print(f"     ✓ {ag_rn}")

        print(f"  [2/4] Creating text assets ({len(cfg['headlines'])}h + {len(cfg['descriptions'])}d + {len(cfg['long_headlines'])}lh)...")
        text_ops, text_map = [], []
        for h in cfg["headlines"]:
            text_ops.append({"create": {"textAsset": {"text": h}}})
            text_map.append("HEADLINE")
        for d in cfg["descriptions"]:
            text_ops.append({"create": {"textAsset": {"text": d}}})
            text_map.append("DESCRIPTION")
        for lh in cfg["long_headlines"]:
            text_ops.append({"create": {"textAsset": {"text": lh}}})
            text_map.append("LONG_HEADLINE")
        res = api_call("POST", "assets:mutate", {"operations": text_ops}, args.customer)
        text_resources = [(r["resourceName"], text_map[i]) for i, r in enumerate(res["results"])]
        print(f"     ✓ {len(text_resources)} text assets")

        print(f"  [3/4] Linking ({len(text_resources) + len(source_images)})...")
        link_ops = []
        for rn, ft in text_resources:
            link_ops.append({"create": {"assetGroup": ag_rn, "asset": rn, "fieldType": ft}})
        for rn, ft in source_images:
            link_ops.append({"create": {"assetGroup": ag_rn, "asset": rn, "fieldType": ft}})
        api_call("POST", "assetGroupAssets:mutate", {"operations": link_ops}, args.customer)
        print(f"     ✓ {len(link_ops)} links")

        print(f"  [4/4] {cfg['asset_group_name']} (id={ag_id}, PAUSED) done")

    print(f"\n{len(brands)} new asset groups created — all PAUSED.")
    print(f"Source asset group ({args.source_group}) untouched — pause it in UI if no longer needed.")


