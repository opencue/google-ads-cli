#!/usr/bin/env python3
"""gads — portable Google Ads CLI

Auth: GOOGLE_ADS_DEVELOPER_TOKEN env var + `gcloud auth application-default
print-access-token`. Pick the account via --profile <name> (preferred),
GADS_PROFILE env var, default_profile in ~/.config/gads/config.toml, or
explicit --customer <id>.

Profiles live in ~/.config/gads/profiles/<name>.toml and define customer_id,
locale, packs_root, etc. Bulk commands consume per-account TOML packs.

All mutating commands run as DRY-RUN by default. Add --apply to commit.

Commands (read-only):
  list-profiles                               List configured profiles
  list-campaigns                              Active campaigns + budget + bid strategy
  list-conversions                            Conversion actions
  list-assets <asset_group_id>                Assets in an asset group
  list-account-assets                         Account-level sitelinks/callouts/snippets
  list-adgroups [--campaign ID] [--status ENABLED]
  list-keywords [--campaign ID] [--ad-group ID] [--status ENABLED]
  list-recommendations                        Pending Google recommendations
  stats [--days N | --start YYYY-MM-DD --end YYYY-MM-DD] [--campaign ID]
  stats-vs-prev --days N [--campaign ID]      Delta vs prior N days
  gaql "<query>"                              Run any GAQL query

Commands (mutating — dry-run unless --apply):
  delete-conversion <id> [--apply]
  disable-url-expansion <campaign_id> [--apply]   PMAX URL expansion OFF
  enable-url-expansion <campaign_id> [--apply]    PMAX URL expansion ON
  set-bid <campaign_id> --strategy <S> [--target <X>] [--apply]
      S ∈ {TARGET_CPA, TARGET_ROAS, MAXIMIZE_CONVERSIONS, MAXIMIZE_CONVERSION_VALUE}
  set-budget <campaign_id> --daily <amount> [--apply]    daily budget in account currency
  set-status <resource_type> <id> {ENABLED|PAUSED} [--apply]
      resource_type ∈ {campaign, ad_group, asset_group}

  add-sitelink <text> <url> [--d1 <s>] [--d2 <s>] [--apply]
  add-callout <text> [--apply]
  add-snippet <header> <v1> <v2> <v3>... [--apply]   header must be a Google enum
  seed-account-assets --pack <file> [--apply]        bulk sitelinks/callouts/snippets

  add-text-assets <ag_id> --field-type {HEADLINE|DESCRIPTION|LONG_HEADLINE|BUSINESS_NAME} "<t1>"... [--apply]
  add-business-name <ag_id> <name> [--apply]
  upload-image <ag_id> <file> --field-type <ft> [--name <s>] [--apply]
  add-youtube-video <ag_id> <video_id_or_url> [--name <s>] [--apply]

  replace-headlines <asset_group_id> --pack <file> [--apply]
      Atomic remove old + add new headlines from a brand pack TOML
  create-brand-campaign --pack <file> [--apply]
      Full Search campaign (budget + geo + ad group + keywords + RSA), PAUSED on create
  split-asset-group <source_ag> --brand-packs <p1,p2,p3> [--apply]
      Spawn N new asset groups from brand pack TOMLs (images copied from source)

Examples:
  gads list-profiles
  gads list-campaigns
  gads stats --days 30
  gads stats-vs-prev --days 14
  gads delete-conversion <conversion_id> --apply
  gads set-budget <campaign_id> --daily 5000 --apply
  gads set-status campaign <campaign_id> ENABLED --apply
"""

import argparse
import base64
import datetime
import json
import os
import subprocess
import sys
import tomllib
import urllib.error
import urllib.request
from pathlib import Path

API_VERSION = "v21"
API_BASE = f"https://googleads.googleapis.com/{API_VERSION}"

# ─── Profile / pack loaders ───────────────────────────────────────────────
#
# A profile is a TOML file under ~/.config/gads/profiles/<name>.toml that
# describes a Google Ads account (customer_id, locale, packs_root, etc.).
# A pack is a TOML file with bulk content (sitelinks, headlines, brand
# config) that bulk commands consume via --pack <path>.

_GADS_CONFIG_DIR = Path.home() / ".config" / "gads"
_loaded_profile_cache = None


def _load_global_config():
    cfg_path = _GADS_CONFIG_DIR / "config.toml"
    if not cfg_path.exists():
        return {}
    with open(cfg_path, "rb") as f:
        return tomllib.load(f)


def _load_profile(name=None):
    """Resolve and load a profile TOML. Search order:
    1. explicit `name` arg (typically from --profile flag)
    2. GADS_PROFILE env var
    3. default_profile in ~/.config/gads/config.toml
    Returns None if no profile is configured (commands then need --customer).
    """
    global _loaded_profile_cache
    if _loaded_profile_cache and not name:
        return _loaded_profile_cache
    name = name or os.environ.get("GADS_PROFILE")
    if not name:
        name = _load_global_config().get("default_profile")
    if not name:
        return None
    path = _GADS_CONFIG_DIR / "profiles" / f"{name}.toml"
    if not path.exists():
        sys.exit(f"ERROR: profile '{name}' nem található: {path}")
    with open(path, "rb") as f:
        prof = tomllib.load(f)
    prof["_name"] = name
    _loaded_profile_cache = prof
    return prof


def _resolve_customer(args):
    """Return a customer_id. Order: --customer arg, profile, env, error."""
    if getattr(args, "customer", None):
        return str(args.customer)
    prof = _load_profile(getattr(args, "profile", None))
    if prof and prof.get("customer_id"):
        return str(prof["customer_id"])
    env_cid = os.environ.get("GOOGLE_ADS_CUSTOMER_ID", "").strip()
    if env_cid:
        return env_cid
    sys.exit("ERROR: nincs customer_id. Adj meg --customer XXXX vagy állíts be "
             "profile-t (~/.config/gads/profiles/<name>.toml + default_profile).")


def _load_pack(pack_arg, profile=None):
    """Load a pack TOML. `pack_arg` is the value passed to --pack; can be an
    absolute path, a relative path (resolved against profile.packs_root), or
    a bare name like 'brand-a' (resolved as <packs_root>/<name>.toml or
    <packs_root>/brands/<name>.toml)."""
    if not pack_arg:
        sys.exit("ERROR: --pack kötelező ennél a parancsnál.")
    p = Path(pack_arg)
    if p.is_absolute() and p.exists():
        with open(p, "rb") as f:
            return tomllib.load(f)
    if profile and profile.get("packs_root"):
        root = Path(profile["packs_root"])
        for candidate in (
            root / pack_arg,
            root / f"{pack_arg}.toml",
            root / "brands" / f"{pack_arg}.toml",
        ):
            if candidate.exists():
                with open(candidate, "rb") as f:
                    return tomllib.load(f)
    if p.exists():
        with open(p, "rb") as f:
            return tomllib.load(f)
    sys.exit(f"ERROR: pack file nem található: {pack_arg}")


# ─── Auth helpers ──────────────────────────────────────────────────────────

def env_or_die(name):
    val = os.environ.get(name, "").strip()
    if not val:
        sys.exit(f"ERROR: {name} env nincs beállítva. Source-old a ~/.bashrc-t.")
    return val


_access_token_cache = None

def get_access_token():
    """Get fresh ADC access token via gcloud (cached per-invocation)."""
    global _access_token_cache
    if _access_token_cache:
        return _access_token_cache
    try:
        result = subprocess.run(
            ["gcloud", "auth", "application-default", "print-access-token"],
            capture_output=True, text=True, check=True,
        )
        _access_token_cache = result.stdout.strip()
        return _access_token_cache
    except subprocess.CalledProcessError as e:
        sys.exit(f"ERROR: gcloud ADC token nem elérhető:\n{e.stderr}")
    except FileNotFoundError:
        sys.exit("ERROR: gcloud nincs telepítve / nincs a PATH-ban.")


def api_call(method, path, body=None, customer_id=None):
    if not customer_id:
        sys.exit("ERROR: api_call requires customer_id (bug: caller didn't pass one)")
    """Make a Google Ads REST API call. path is relative to /customers/{id}/."""
    url = f"{API_BASE}/customers/{customer_id}/{path}"
    headers = {
        "Authorization": f"Bearer {get_access_token()}",
        "developer-token": env_or_die("GOOGLE_ADS_DEVELOPER_TOKEN"),
        "Content-Type": "application/json",
    }
    login_cid = os.environ.get("GOOGLE_ADS_LOGIN_CUSTOMER_ID", "").strip()
    if login_cid:
        headers["login-customer-id"] = login_cid

    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(url, method=method, headers=headers, data=data)
    try:
        with urllib.request.urlopen(req) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        err_body = e.read().decode(errors="replace")
        try:
            err_json = json.loads(err_body)
            msg = json.dumps(err_json, indent=2, ensure_ascii=False)
        except Exception:
            msg = err_body
        hint = _hint_for_api_error(e.code, err_body)
        sys.exit(f"API ERROR {e.code} {e.reason}\n{msg}{hint}")


# Common Google Ads API error codes → short remediation hint.
_ERROR_HINTS = {
    "AUTHENTICATION_ERROR":      "Run `gcloud auth application-default login` to refresh the ADC token.",
    "AUTHORIZATION_ERROR":       "ADC user may lack access to this customer, or login_customer_id is wrong.",
    "DEVELOPER_TOKEN_NOT_APPROVED": "Apply for Basic Access in the Ads API Center; Test tokens block mutations on prod accounts.",
    "DEVELOPER_TOKEN_NOT_REGISTERED": "GOOGLE_ADS_DEVELOPER_TOKEN env var is missing or wrong.",
    "QUOTA_ERROR":               "Throttled by API quota — wait a minute and retry.",
    "INTERNAL_ERROR":            "Transient Google-side error — retry in 30 seconds.",
    "TOO_LONG":                  "A text field exceeds Google's character limit. en-dash/em-dash/minus count as 2 chars in Google's display-width counting.",
    "INVALID_FORMAT":            "Check enum-valued fields (snippet header must be 'Brands', 'Types', 'Models', etc. — not arbitrary text).",
    "RESOURCE_ALREADY_EXISTS":   "This asset/link already exists. Re-run gads list-* to see current state.",
    "BRAND_ASSETS_NOT_LINKED_AT_CAMPAIGN_LEVEL": "PMAX Brand Guidelines: BUSINESS_NAME and LOGO must link to the campaign, not the asset group.",
    "FIELD_ERROR":               "Required field missing. Check the API error 'fieldPathElements' to see which.",
}


def _hint_for_api_error(http_code, err_body):
    for code, hint in _ERROR_HINTS.items():
        if code in err_body:
            return f"\n💡 Hint: {hint}"
    if http_code == 401:
        return "\n💡 Hint: Auth failed. `gads auth check` (once added) or re-run `gcloud auth application-default login`."
    if http_code == 403:
        return "\n💡 Hint: Forbidden. Check developer token approval level + login_customer_id."
    if http_code == 429:
        return "\n💡 Hint: Rate-limited. Wait and retry."
    return ""


# ─── Display helpers ──────────────────────────────────────────────────────

def micros_to_units(micros):
    """Format a micros value as account-currency units. Currency-agnostic
    (Google API stores all monetary fields as micros; 1 unit = 1_000_000)."""
    if micros is None:
        return "—"
    return f"{int(micros) / 1_000_000:.0f}"


