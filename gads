def cmd_list_profiles(args):
    pdir = _GADS_CONFIG_DIR / "profiles"
    if not pdir.exists():
        if args.format == "json":
            _emit_json({"profiles": [], "default_profile": None, "config_dir": str(pdir)})
        else:
            print(f"No profiles directory yet at {pdir}")
            print(f"Create one: mkdir -p {pdir} && put <name>.toml files in it.")
        return
    default = _load_global_config().get("default_profile")

    profiles = []
    for path in sorted(pdir.glob("*.toml")):
        try:
            with open(path, "rb") as f:
                p = tomllib.load(f)
            profiles.append({
                "name": path.stem,
                "customer_id": p.get("customer_id"),
                "packs_root": p.get("packs_root"),
                "is_default": path.stem == default,
                "parse_error": None,
            })
        except Exception as e:
            profiles.append({
                "name": path.stem, "customer_id": None, "packs_root": None,
                "is_default": False, "parse_error": str(e),
            })

    if args.format == "json":
        _emit_json({"profiles": profiles, "default_profile": default})
        return

    print(f"{'NAME':<24}  {'CUSTOMER_ID':<14}  {'DEFAULT':<8}  PACKS ROOT")
    print("-" * 100)
    for p in profiles:
        if p["parse_error"]:
            print(f"{p['name']:<24}  [parse error: {p['parse_error']}]")
            continue
        is_default = "✓" if p["is_default"] else ""
        print(f"{p['name']:<24}  {p.get('customer_id') or '—':<14}  {is_default:<8}  {p.get('packs_root') or ''}")


