def cmd_create_brand_campaign(args):
    profile = _load_profile(args.profile)
    pack = _load_pack(args.pack, profile)

    name = pack.get("name") or "Brand Search"
    final_url = pack.get("final_url")
    if not final_url:
        sys.exit("ERROR: pack must define 'final_url'")
    daily = float(pack.get("daily_budget") or 0)
    if daily <= 0:
        sys.exit("ERROR: pack must define 'daily_budget' > 0")
    bidding = (pack.get("bidding_strategy") or "MAXIMIZE_CONVERSIONS").upper()
    status = (pack.get("status_on_create") or "PAUSED").upper()
    ag_bid_units = int(pack.get("ad_group_bid") or 200)

    keywords = pack.get("keywords") or []
    headlines = pack.get("headlines") or []
    descriptions = pack.get("descriptions") or []
    if not keywords:
        sys.exit("ERROR: pack must define [[keywords]] (at least 1)")
    if len(headlines) < 3:
        sys.exit("ERROR: RSA needs ≥3 headlines")
    if len(descriptions) < 2:
        sys.exit("ERROR: RSA needs ≥2 descriptions")

    for h in headlines:
        if _google_width(h) > 30:
            sys.exit(f"ERROR: RSA headline '{h}' Google-width > 30")
    for d in descriptions:
        if _google_width(d) > 90:
            sys.exit(f"ERROR: RSA description '{d}' Google-width > 90")

    # Geo targets from profile.locale (list of geoTargetConstant integer IDs)
    geo_ids = (profile or {}).get("locale", {}).get("geo_targets") or []

    print(f"Brand Search campaign plan:\n")
    print(f"  Name:          {name}")
    print(f"  Budget:        {daily:,.0f}/day  (account currency)")
    print(f"  Bidding:       {bidding}")
    print(f"  Channel:       SEARCH (Google Search only — Search Network OFF)")
    print(f"  Status:        {status}")
    print(f"  Geo targets:   {geo_ids if geo_ids else '(none — campaign will serve everywhere)'}")
    print(f"  Final URL:     {final_url}\n")
    print(f"  Keywords ({len(keywords)}):")
    for kw in keywords:
        print(f"    • [{kw['match_type']:<7}] {kw['text']}")
    print(f"\n  RSA headlines ({len(headlines)}):")
    for h in headlines:
        print(f"    • ({_google_width(h):>2}) {h}")
    print(f"\n  RSA descriptions ({len(descriptions)}):")
    for d in descriptions:
        print(f"    • ({_google_width(d):>2}) {d}")

    if not args.apply:
        dry_run_banner("CREATE BRAND SEARCH CAMPAIGN", name)
        return

    cid = args.customer

    print("\n[1/6] Campaign budget...")
    micros = int(daily * 1_000_000)
    budget_op = {"create": {
        "name": f"{name} — budget",
        "amountMicros": str(micros),
        "deliveryMethod": "STANDARD",
        "explicitlyShared": False,
    }}
    res = api_call("POST", "campaignBudgets:mutate", {"operations": [budget_op]}, cid)
    budget_rn = res["results"][0]["resourceName"]
    print(f"  ✓ {budget_rn}")

    print(f"\n[2/6] Campaign (SEARCH, {bidding}, {status})...")
    bidding_field = {
        "MAXIMIZE_CONVERSIONS": ("maximizeConversions", {}),
        "MAXIMIZE_CONVERSION_VALUE": ("maximizeConversionValue", {}),
        "MANUAL_CPC": ("manualCpc", {"enhancedCpcEnabled": False}),
    }.get(bidding)
    if not bidding_field:
        sys.exit(f"ERROR: unsupported bidding_strategy '{bidding}'")
    campaign_op = {"create": {
        "name": name,
        "status": status,
        "advertisingChannelType": "SEARCH",
        bidding_field[0]: bidding_field[1],
        "campaignBudget": budget_rn,
        "containsEuPoliticalAdvertising": "DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING",
        "networkSettings": {
            "targetGoogleSearch": True,
            "targetSearchNetwork": False,
            "targetContentNetwork": False,
            "targetPartnerSearchNetwork": False,
        },
    }}
    res = api_call("POST", "campaigns:mutate", {"operations": [campaign_op]}, cid)
    campaign_rn = res["results"][0]["resourceName"]
    print(f"  ✓ {campaign_rn}")

    print(f"\n[3/6] Geo targeting...")
    if geo_ids:
        geo_ops = [{"create": {
            "campaign": campaign_rn,
            "location": {"geoTargetConstant": f"geoTargetConstants/{g}"},
        }} for g in geo_ids]
        api_call("POST", "campaignCriteria:mutate", {"operations": geo_ops}, cid)
        print(f"  ✓ {len(geo_ids)} geo target hozzáadva")
    else:
        print(f"  — no geo_targets in profile, skipping")

    print("\n[4/6] Ad group...")
    ad_group_op = {"create": {
        "name": f"{name} — Brand",
        "campaign": campaign_rn,
        "type": "SEARCH_STANDARD",
        "status": "ENABLED",
        "cpcBidMicros": str(ag_bid_units * 1_000_000),
    }}
    res = api_call("POST", "adGroups:mutate", {"operations": [ad_group_op]}, cid)
    ad_group_rn = res["results"][0]["resourceName"]
    print(f"  ✓ {ad_group_rn}")

    print(f"\n[5/6] {len(keywords)} keywords...")
    kw_ops = [{"create": {
        "adGroup": ad_group_rn,
        "status": "ENABLED",
        "keyword": {"text": kw["text"], "matchType": kw["match_type"]},
    }} for kw in keywords]
    api_call("POST", "adGroupCriteria:mutate", {"operations": kw_ops}, cid)
    print(f"  ✓ {len(keywords)} keywords added")

    print("\n[6/6] Responsive Search Ad...")
    rsa_op = {"create": {
        "adGroup": ad_group_rn,
        "status": "ENABLED",
        "ad": {
            "finalUrls": [final_url],
            "responsiveSearchAd": {
                "headlines": [{"text": h} for h in headlines],
                "descriptions": [{"text": d} for d in descriptions],
            },
        },
    }}
    api_call("POST", "adGroupAds:mutate", {"operations": [rsa_op]}, cid)
    print(f"  ✓ RSA created")

    print(f"\nDone. Campaign is {status} — review and enable manually if needed.")
    print(f"Campaign ID: {campaign_rn.rsplit('/',1)[-1]}")


def _check_url(url):
    """HEAD-fallback-GET to check a URL returns 2xx. Returns status code or 0."""
    for method in ("HEAD", "GET"):
        try:
            req = urllib.request.Request(url, method=method,
                                         headers={"User-Agent": "gads-cli/1.0"})
            with urllib.request.urlopen(req, timeout=5) as resp:
                return resp.status
        except urllib.error.HTTPError as e:
            return e.code
        except Exception:
            continue
    return 0


def cmd_seed_account_assets(args):
    pack = _load_pack(args.pack, _load_profile(args.profile))
    sitelinks = pack.get("sitelinks", [])
    callouts = pack.get("callouts", [])
    snippets = pack.get("snippets", [])

    existing = _existing_account_assets(args.customer)
    has_any = any(
        existing.get(ft, 0) > 0
        for ft in ("SITELINK", "CALLOUT", "STRUCTURED_SNIPPET")
    )
    if has_any and not args.force:
        print("⚠️  Already account-level assets in this account:")
        for ft in ("SITELINK", "CALLOUT", "STRUCTURED_SNIPPET"):
            n = existing.get(ft, 0)
            if n:
                print(f"     {ft}: {n}")
        print("\nUse --force to seed anyway (will duplicate).")
        print("Or inspect existing: gads list-account-assets")
        return

    print(f"Planned changes for customer {args.customer} (pack: {args.pack}):\n")
    print(f"  {len(sitelinks)} SITELINK:")
    broken_urls = []
    for sl in sitelinks:
        code = _check_url(sl["url"])
        flag = "✓" if 200 <= code < 300 else f"✗ HTTP {code}"
        if not (200 <= code < 300):
            broken_urls.append((sl["text"], sl["url"], code))
        print(f"    {flag}  {sl['text']:<22}  → {sl['url']}")
        print(f"          d1: {sl.get('d1', '')}")
        print(f"          d2: {sl.get('d2', '')}")
    if broken_urls and not args.skip_url_check:
        print(f"\n  ⚠️  {len(broken_urls)} URL not 2xx — Google Ads will disapprove.")
        print(f"     Fix the pack, or pass --skip-url-check.")

    print(f"\n  {len(callouts)} CALLOUT:")
    for c in callouts:
        print(f"    • {c}  ({len(c)} chars)")

    print(f"\n  {len(snippets)} STRUCTURED_SNIPPET:")
    for s in snippets:
        print(f"    • {s['header']}: {', '.join(s['values'])}")

    if not args.apply:
        dry_run_banner(f"SEED {len(sitelinks)}+{len(callouts)}+{len(snippets)} account-level asset", args.customer)
        return

    if broken_urls and not args.skip_url_check:
        sys.exit("\n❌ Refusing to run — broken URLs. Add --skip-url-check to override.")

    print("\nExecuting...")
    for sl in sitelinks:
        body = {
            "finalUrls": [sl["url"]],
            "sitelinkAsset": {
                "linkText": sl["text"],
                "description1": sl.get("d1", ""),
                "description2": sl.get("d2", ""),
            },
        }
        r = _create_asset(body, args.customer)
        _link_to_customer(r, "SITELINK", args.customer)
        print(f"  ✓ sitelink  {sl['text']:<22}  → {r.rsplit('/', 1)[-1]}")

    for c in callouts:
        r = _create_asset({"calloutAsset": {"calloutText": c}}, args.customer)
        _link_to_customer(r, "CALLOUT", args.customer)
        print(f"  ✓ callout   {c:<26}  → {r.rsplit('/', 1)[-1]}")

    for s in snippets:
        r = _create_asset({"structuredSnippetAsset": {"header": s["header"], "values": s["values"]}}, args.customer)
        _link_to_customer(r, "STRUCTURED_SNIPPET", args.customer)
        print(f"  ✓ snippet   {s['header']:<26}  → {r.rsplit('/', 1)[-1]}")

    print("\nDone. Verify: gads list-account-assets")


_STATUS_RESOURCES = {
    "campaign":    ("campaigns",    "campaigns:mutate"),
    "ad_group":    ("adGroups",     "adGroups:mutate"),
    "asset_group": ("assetGroups",  "assetGroups:mutate"),
}


def cmd_set_status(args):
    if args.resource_type not in _STATUS_RESOURCES:
        sys.exit(f"ERROR: resource_type must be one of {list(_STATUS_RESOURCES)}")
    new_status = args.status.upper()
    if new_status not in ("ENABLED", "PAUSED"):
        sys.exit(f"ERROR: status must be ENABLED or PAUSED")
    coll, endpoint = _STATUS_RESOURCES[args.resource_type]
    resource = f"customers/{args.customer}/{coll}/{args.resource_id}"
    body = {"operations": [{
        "update": {"resourceName": resource, "status": new_status},
        "updateMask": "status",
    }]}
    if not args.apply:
        dry_run_banner(f"SET STATUS → {new_status}", resource)
        print(json.dumps(body, indent=2))
        return
    api_call("POST", endpoint, body, args.customer)
    print(f"OK — {args.resource_type} {args.resource_id} → {new_status}")


def cmd_set_budget(args):
    # Need to fetch the budget resource for this campaign first
    q = f"SELECT campaign_budget.resource_name FROM campaign WHERE campaign.id = {args.campaign_id}"
    res = api_call("POST", "googleAds:search", {"query": q}, args.customer)
    rows = res.get("results", [])
    if not rows:
        sys.exit(f"ERROR: nem található kampány {args.campaign_id}")
    budget_resource = rows[0]["campaignBudget"]["resourceName"]

    micros = int(float(args.daily) * 1_000_000)
    body = {
        "operations": [{
            "update": {"resourceName": budget_resource, "amountMicros": str(micros)},
            "updateMask": "amount_micros",
        }]
    }
    if not args.apply:
        dry_run_banner(f"BUDGET → {args.daily}/day", budget_resource)
        print(json.dumps(body, indent=2))
        return
    api_call("POST", "campaignBudgets:mutate", body, args.customer)
    print(f"OK — daily budget {args.daily} on {budget_resource}")


# ─── Suggest: rules-engine over account state ─────────────────────────────
#
# Each rule is a function taking `state` (a dict of account snapshots
# pre-fetched once) and returning None or an Issue dict.  Add new rules
# by appending to `_SUGGEST_RULES` — they auto-run and sort by severity.

def _gather_account_state(customer_id):
    """One-shot snapshot used by all suggest rules. Single GAQL fan-out."""
    state = {"customer_id": customer_id}

    # Account: optimization score, currency, time zone
    res = api_call("POST", "googleAds:search", {"query":
        "SELECT customer.optimization_score, customer.currency_code, "
        "customer.time_zone FROM customer"}, customer_id)
    rows = res.get("results", [])
    if rows:
        c = rows[0]["customer"]
        state["optimization_score"] = float(c.get("optimizationScore", 0))
        state["currency"] = c.get("currencyCode")
        state["time_zone"] = c.get("timeZone")

    # Campaigns + last-30d perf
    today = datetime.date.today()
    end_d = today - datetime.timedelta(days=1)
    start_d = end_d - datetime.timedelta(days=29)
    res = api_call("POST", "googleAds:search", {"query": f"""
        SELECT
          campaign.id, campaign.name, campaign.status,
          campaign.advertising_channel_type,
          campaign_budget.amount_micros,
          metrics.cost_micros, metrics.impressions, metrics.clicks,
          metrics.conversions, metrics.conversions_value,
          metrics.search_impression_share,
          metrics.search_budget_lost_impression_share,
          metrics.search_rank_lost_impression_share
        FROM campaign
        WHERE segments.date BETWEEN '{start_d}' AND '{end_d}'
          AND campaign.status != 'REMOVED'
    """}, customer_id)
    state["campaigns"] = res.get("results", [])

    # Asset groups + ad strength
    res = api_call("POST", "googleAds:search", {"query":
        "SELECT asset_group.id, asset_group.name, asset_group.status, "
        "asset_group.ad_strength, asset_group.final_urls, campaign.id "
        "FROM asset_group WHERE asset_group.status != 'REMOVED'"}, customer_id)
    state["asset_groups"] = res.get("results", [])

    # Conversion actions
    res = api_call("POST", "googleAds:search", {"query":
        "SELECT conversion_action.id, conversion_action.name, "
        "conversion_action.status, conversion_action.primary_for_goal "
        "FROM conversion_action WHERE conversion_action.status != 'REMOVED'"
    }, customer_id)
    state["conversion_actions"] = res.get("results", [])

    return state


# Each rule returns None (no issue) or a dict with keys:
#   rule, severity (P0/P1/P2), title, detail, suggest (cmd or None), context (dict)
def _rule_optimization_score_zero(state):
    if state.get("optimization_score", 1.0) <= 0.01:
        return {
            "rule": "optimization_score_zero",
            "severity": "P0",
            "title": "Optimization Score is 0%",
            "detail": "Google's own health score is 0% — the account is below the floor of every recommendation. Usually a tracking gap + missing extensions + thin assets. Address P0/P1 items below to lift it.",
            "suggest": None,
            "context": {"optimization_score": state["optimization_score"]},
        }
    return None


def _rule_no_conversions_30d(state):
    if not state.get("conversion_actions"):
        return None
    total_clicks = sum(int(row.get("metrics", {}).get("clicks", 0))
                       for row in state.get("campaigns", []))
    total_conv = sum(float(row.get("metrics", {}).get("conversions", 0))
                     for row in state.get("campaigns", []))
    if total_clicks >= 5 and total_conv == 0:
        return {
            "rule": "no_conversions_30d",
            "severity": "P0",
            "title": "No conversions registered in 30 days",
            "detail": f"{total_clicks} clicks in 30d, 0 conversions. Either tracking is broken (env var missing, GTM tag not firing) or genuinely no purchases yet. Run a test purchase + watch the 'Last received conversion' timestamp in the Ads UI.",
            "suggest": "gads auth-check  # confirm reachability + then test purchase manually",
            "context": {"clicks_30d": total_clicks, "conversions_30d": total_conv},
        }
    return None


def _rule_ad_strength_poor(state):
    poor = [
        ag for ag in state.get("asset_groups", [])
        if ag["assetGroup"].get("adStrength") == "POOR"
        and ag["assetGroup"].get("status") == "ENABLED"
    ]
    if not poor:
        return None
    names = ", ".join(ag["assetGroup"]["name"] for ag in poor)
    ag_id = poor[0]["assetGroup"]["id"]
    return {
        "rule": "ad_strength_poor",
        "severity": "P1",
        "title": f"{len(poor)} asset group(s) rated POOR",
        "detail": f"Asset group(s): {names}. POOR rating restricts where ads can serve. Most common gap: missing YOUTUBE_VIDEO (PMAX requires 1). Also check sitelinks/callouts/snippets at account level.",
        "suggest": f"gads list-assets {ag_id}    # see what's there\ngads add-youtube-video {ag_id} <video_id> --apply",
        "context": {"poor_asset_group_ids": [ag["assetGroup"]["id"] for ag in poor]},
    }


def _rule_lost_is_rank_high(state):
    worst = 0.0
    worst_campaign = None
    for row in state.get("campaigns", []):
        lr = float(row.get("metrics", {}).get("searchRankLostImpressionShare", 0))
        if lr > worst:
            worst, worst_campaign = lr, row["campaign"]["name"]
    if worst > 0.5:
        return {
            "rule": "lost_is_rank_high",
            "severity": "P1",
            "title": f"Lost IS to rank {worst*100:.1f}% (campaign: {worst_campaign})",
            "detail": "Losing >50% of impressions because Google rates your ads weaker than competitors'. Drivers: weak Ad Strength, generic headlines, missing extensions, low Quality Score. Add the missing extensions + replace generic headlines with USP-driven ones.",
            "suggest": "gads seed-account-assets --pack account-assets --apply\ngads replace-headlines <ag_id> --pack <brand> --apply",
            "context": {"lost_is_rank": worst, "worst_campaign": worst_campaign},
        }
    return None


def _rule_lost_is_budget_high(state):
    worst = 0.0
    worst_campaign = None
    for row in state.get("campaigns", []):
        lb = float(row.get("metrics", {}).get("searchBudgetLostImpressionShare", 0))
        if lb > worst:
            worst, worst_campaign = lb, row["campaign"]["name"]
    if worst > 0.3:
        return {
            "rule": "lost_is_budget_high",
            "severity": "P2",
            "title": f"Lost IS to budget {worst*100:.1f}% (campaign: {worst_campaign})",
            "detail": "Daily budget runs out mid-day. If conversions are landing, you have headroom to ramp budget without losing ROAS. Increase by 30-50% per week, not in one jump (PMAX re-learns).",
            "suggest": "gads set-budget <campaign_id> --daily <new_amount> --apply",
            "context": {"lost_is_budget": worst, "worst_campaign": worst_campaign},
        }
    return None


def _rule_no_brand_search(state):
    has_brand_search = any(
        "brand" in row["campaign"]["name"].lower()
        and row["campaign"].get("advertisingChannelType") == "SEARCH"
        for row in state.get("campaigns", [])
    )
    if has_brand_search:
        return None
    return {
        "rule": "no_brand_search",
        "severity": "P1",
        "title": "No Brand Search campaign detected",
        "detail": "Brand search clicks are the cheapest, highest-intent traffic. Without a brand campaign, competitors can bid on your name and you pay more via PMAX for what should be defensive brand traffic.",
        "suggest": "gads create-brand-campaign --pack brand-search --apply",
        "context": {},
    }


def _rule_no_account_assets(state):
    res = api_call("POST", "googleAds:search", {"query":
        "SELECT customer_asset.field_type FROM customer_asset "
        "WHERE customer_asset.status != 'REMOVED'"}, state["customer_id"])
    field_types = set(row["customerAsset"]["fieldType"]
                      for row in res.get("results", []))
    missing = [ft for ft in ("SITELINK", "CALLOUT", "STRUCTURED_SNIPPET")
               if ft not in field_types]
    if not missing:
        return None
    return {
        "rule": "no_account_assets",
        "severity": "P1",
        "title": f"Missing account-level: {', '.join(missing)}",
        "detail": "Account-level sitelinks/callouts/snippets attach to every campaign automatically and raise Ad Strength + visibility. Without them you lose ~20% of impression real estate.",
        "suggest": "gads seed-account-assets --pack account-assets --apply",
        "context": {"missing_field_types": missing},
    }


_SUGGEST_RULES = [
    _rule_optimization_score_zero,
    _rule_no_conversions_30d,
    _rule_ad_strength_poor,
    _rule_lost_is_rank_high,
    _rule_lost_is_budget_high,
    _rule_no_brand_search,
    _rule_no_account_assets,
]

_SEVERITY_RANK = {"P0": 0, "P1": 1, "P2": 2}
_SEVERITY_GLYPH = {"P0": "✗", "P1": "⚠", "P2": "✓"}


def cmd_suggest(args):
    if args.format != "json":
        print(f"Auditing customer {args.customer}...\n")
    state = _gather_account_state(args.customer)

    issues = []
    for rule in _SUGGEST_RULES:
        try:
            result = rule(state)
            if result:
                issues.append(result)
        except Exception as e:
            issues.append({
                "rule": rule.__name__, "severity": "P2",
                "title": "Rule errored",
                "detail": f"{rule.__name__} raised: {e}",
                "suggest": None, "context": {},
            })
    issues.sort(key=lambda i: (_SEVERITY_RANK.get(i["severity"], 9), i["rule"]))

    if args.format == "json":
        _emit_json({
            "customer_id": args.customer,
            "optimization_score": state.get("optimization_score"),
            "issues": issues,
        })
        return

    if not issues:
        print("✓ No issues flagged. Re-run periodically.")
        return

    for issue in issues:
        glyph = _SEVERITY_GLYPH.get(issue["severity"], "•")
        print(f"{glyph} {issue['severity']}  {issue['title']}")
        # Wrap detail to ~76 cols at word boundaries.
        import textwrap
        for line in textwrap.wrap(issue["detail"], width=76,
                                   initial_indent="      ", subsequent_indent="      "):
            print(line)
        if issue.get("suggest"):
            print(f"      Try:")
            for cmd in issue["suggest"].splitlines():
                print(f"        {cmd.strip()}")
        print()

    p0 = sum(1 for i in issues if i["severity"] == "P0")
    p1 = sum(1 for i in issues if i["severity"] == "P1")
    p2 = sum(1 for i in issues if i["severity"] == "P2")
    print(f"Summary: {p0} P0  |  {p1} P1  |  {p2} P2")


# ─── Declarative state: export / plan / sync ─────────────────────────────
#
# v1 scope: campaign status + daily budget. Asset groups, keywords, RSA
# copy, and account-level assets are roadmap. The export format is TOML
# so it's hand-editable + diff-friendly in git.

def _live_account_assets_state(customer_id):
    """Snapshot account-scope sitelinks/callouts/snippets."""
    res = api_call("POST", "googleAds:search", {"query": """
        SELECT customer_asset.field_type, asset.id, asset.type,
               asset.sitelink_asset.link_text,
               asset.sitelink_asset.description1,
               asset.sitelink_asset.description2,
               asset.final_urls,
               asset.callout_asset.callout_text,
               asset.structured_snippet_asset.header,
               asset.structured_snippet_asset.values
        FROM customer_asset
        WHERE customer_asset.status != 'REMOVED'
    """}, customer_id)
    sitelinks, callouts, snippets = [], [], []
    for row in res.get("results", []):
        ft = row["customerAsset"]["fieldType"]
        asset = row["asset"]
        if ft == "SITELINK":
            sl = asset.get("sitelinkAsset", {})
            sitelinks.append({
                "id": asset["id"],
                "text": sl.get("linkText", ""),
                "url": (asset.get("finalUrls") or [""])[0],
                "d1": sl.get("description1", ""),
                "d2": sl.get("description2", ""),
            })
        elif ft == "CALLOUT":
            callouts.append({
                "id": asset["id"],
                "text": asset.get("calloutAsset", {}).get("calloutText", ""),
            })
        elif ft == "STRUCTURED_SNIPPET":
            ss = asset.get("structuredSnippetAsset", {})
            snippets.append({
                "id": asset["id"],
                "header": ss.get("header", ""),
                "values": ss.get("values", []),
            })
    return {"sitelinks": sitelinks, "callouts": callouts, "snippets": snippets}


def _live_campaigns_state(customer_id):
    """Snapshot live campaigns into the export TOML shape."""
    res = api_call("POST", "googleAds:search", {"query": """
        SELECT campaign.id, campaign.name, campaign.status,
               campaign.advertising_channel_type,
               campaign_budget.amount_micros
        FROM campaign
        WHERE campaign.status != 'REMOVED'
        ORDER BY campaign.id
    """}, customer_id)
    out = []
    for row in res.get("results", []):
        c = row["campaign"]
        cb = row.get("campaignBudget", {})
        out.append({
            "id": c["id"],
            "name": c["name"],
            "status": c["status"],
            "channel_type": c["advertisingChannelType"],
            "budget_daily": int(cb.get("amountMicros", "0")) // 1_000_000,
        })
    return out


def _toml_escape(s):
    """Minimal TOML string escape for the limited subset we emit."""
    return s.replace("\\", "\\\\").replace('"', '\\"')


def _serialize_state_toml(state):
    """Write state to TOML format. Hand-rolled; covers v2 schema:
    campaigns + account-level sitelinks/callouts/snippets."""
    lines = [
        "# gads state file (v2). Hand-edit to describe desired account state.",
        "# Generated by `gads export` — re-running export will overwrite.",
        "# Use `gads plan <file>` to preview diff vs live, `gads sync <file>`",
        "# to apply. v2 supports campaign status+budget + account-level",
        "# sitelinks / callouts / structured snippets.",
        "#",
        "# To ADD a new sitelink/callout/snippet: append a [[sitelinks]] (etc.)",
        "# block WITHOUT an `id` field. sync will create it.",
        "# To REMOVE an existing asset: delete its block AND pass --prune to sync.",
        "",
        "[account]",
        f'customer_id = "{state["account"]["customer_id"]}"',
        "",
    ]
    for c in state.get("campaigns", []):
        lines.append("[[campaigns]]")
        lines.append(f'id = "{c["id"]}"                           # readonly')
        lines.append(f'name = "{_toml_escape(c["name"])}"')
        lines.append(f'status = "{c["status"]}"                    # ENABLED or PAUSED')
        lines.append(f'channel_type = "{c["channel_type"]}"        # readonly hint')
        lines.append(f'budget_daily = {c["budget_daily"]}            # in account currency')
        lines.append("")

    for sl in state.get("sitelinks", []):
        lines.append("[[sitelinks]]")
        if sl.get("id"):
            lines.append(f'id = "{sl["id"]}"                          # readonly')
        lines.append(f'text = "{_toml_escape(sl.get("text", ""))}"')
        lines.append(f'url = "{_toml_escape(sl.get("url", ""))}"')
        lines.append(f'd1 = "{_toml_escape(sl.get("d1", ""))}"')
        lines.append(f'd2 = "{_toml_escape(sl.get("d2", ""))}"')
        lines.append("")

    for co in state.get("callouts", []):
        lines.append("[[callouts]]")
        if co.get("id"):
            lines.append(f'id = "{co["id"]}"')
        lines.append(f'text = "{_toml_escape(co.get("text", ""))}"')
        lines.append("")

    for sn in state.get("snippets", []):
        lines.append("[[snippets]]")
        if sn.get("id"):
            lines.append(f'id = "{sn["id"]}"')
        lines.append(f'header = "{_toml_escape(sn.get("header", ""))}"')
        vals = sn.get("values", [])
        values_str = ", ".join(f'"{_toml_escape(v)}"' for v in vals)
        lines.append(f'values = [{values_str}]')
        lines.append("")

    return "\n".join(lines)


def cmd_export(args):
    assets = _live_account_assets_state(args.customer)
    state = {
        "account": {"customer_id": args.customer},
        "campaigns": _live_campaigns_state(args.customer),
        **assets,
    }
    serialized = _serialize_state_toml(state)
    counts = (
        f"{len(state['campaigns'])} campaign(s), "
        f"{len(state['sitelinks'])} sitelink(s), "
        f"{len(state['callouts'])} callout(s), "
        f"{len(state['snippets'])} snippet(s)"
    )
    if args.output and args.output != "-":
        Path(args.output).write_text(serialized)
        print(f"Wrote {args.output}  ({counts})")
    else:
        sys.stdout.write(serialized)


def _load_state_file(path):
    p = Path(path)
    if not p.exists():
        sys.exit(f"ERROR: state file not found: {path}")
    with open(p, "rb") as f:
        return tomllib.load(f)


def _compute_diff(state_file, customer_id):
    """Returns list of change dicts. Each has at minimum 'kind' and
    'operation' keys. Kinds: campaign, sitelink, callout, snippet.
    Operations: update (with field/current/desired), create (with data),
    prune (with data), missing_in_live, only_in_live."""
    changes = []

    # ---- Campaigns ----
    desired = {c["id"]: c for c in state_file.get("campaigns", [])}
    live = {c["id"]: c for c in _live_campaigns_state(customer_id)}
    for cid, want in desired.items():
        have = live.get(cid)
        if not have:
            changes.append({
                "kind": "campaign", "operation": "missing_in_live",
                "campaign_id": cid, "name": want.get("name", "?"),
                "field": "_missing_in_live", "current": None,
                "desired": "exists in state file",
            })
            continue
        for field in ("status", "budget_daily"):
            cur = have.get(field)
            des = want.get(field)
            if des is not None and cur != des:
                changes.append({
                    "kind": "campaign", "operation": "update",
                    "campaign_id": cid,
                    "name": want.get("name") or have.get("name"),
                    "field": field, "current": cur, "desired": des,
                })
    for cid, have in live.items():
        if cid not in desired:
            changes.append({
                "kind": "campaign", "operation": "only_in_live",
                "campaign_id": cid, "name": have["name"],
                "field": "_only_in_live", "current": "exists live",
                "desired": None,
            })

    # ---- Account-level assets (sitelinks, callouts, snippets) ----
    # Only diff if the state file mentions the asset kind at all — empty
    # arrays mean "I declare these explicitly", a missing key means
    # "don't manage this kind".
    live_assets = _live_account_assets_state(customer_id)
    for kind in ("sitelinks", "callouts", "snippets"):
        if kind not in state_file:
            continue
        desired_list = state_file[kind]
        live_list = live_assets[kind]
        state_ids = {e["id"] for e in desired_list if e.get("id")}

        # CREATE: state-file entries without an id
        for entry in desired_list:
            if not entry.get("id"):
                changes.append({
                    "kind": kind[:-1],  # sitelinks -> sitelink
                    "operation": "create",
                    "data": entry,
                })
        # PRUNE: live entries whose id is not referenced by state file
        for live_entry in live_list:
            if live_entry["id"] not in state_ids:
                changes.append({
                    "kind": kind[:-1],
                    "operation": "prune",
                    "data": live_entry,
                })
    return changes


def _change_summary(ch):
    """One-line human-readable rendering of a change dict."""
    kind = ch.get("kind", "?")
    op = ch.get("operation", "?")
    if kind == "campaign":
        if op == "missing_in_live":
            return f"⚠  campaign {ch['campaign_id']} in state file but not live: '{ch['name']}'"
        if op == "only_in_live":
            return f"⚠  campaign {ch['campaign_id']} live but missing from state file: '{ch['name']}'"
        return f"~  campaign '{ch['name']}' [{ch['campaign_id']}]  {ch['field']}: {ch['current']!r} → {ch['desired']!r}"
    if kind == "sitelink":
        d = ch["data"]
        if op == "create":
            return f"+  sitelink  '{d.get('text','')}' → {d.get('url','')}"
        if op == "prune":
            return f"-  sitelink  [{d['id']}] '{d.get('text','')}'"
    if kind == "callout":
        d = ch["data"]
        if op == "create":
            return f"+  callout   '{d.get('text','')}'"
        if op == "prune":
            return f"-  callout   [{d['id']}] '{d.get('text','')}'"
    if kind == "snippet":
        d = ch["data"]
        if op == "create":
            return f"+  snippet   {d.get('header','')}: {', '.join(d.get('values',[]))}"
        if op == "prune":
            return f"-  snippet   [{d['id']}] {d.get('header','')}"
    return f"?  {kind} {op}"


def cmd_plan(args):
    state_file = _load_state_file(args.state_file)
    changes = _compute_diff(state_file, args.customer)

    if args.format == "json":
        _emit_json({"state_file": args.state_file, "changes": changes})
        return

    if not changes:
        print("✓ No drift — state file matches live account.")
        return

    print(f"Plan for customer {args.customer} ({len(changes)} change(s)):\n")
    for ch in changes:
        print(f"  {_change_summary(ch)}")
    print(f"\nRun `gads sync {args.state_file} --apply` to apply.")
    print(f"Add `--prune` to also remove account assets that exist live but not in the state file.")


def _apply_change(ch, customer_id):
    """Apply a single change dict. Returns short result string."""
    kind, op = ch.get("kind"), ch.get("operation")
    if kind == "campaign" and op == "update":
        cid = ch["campaign_id"]
        if ch["field"] == "status":
            resource = f"customers/{customer_id}/campaigns/{cid}"
            body = {"operations": [{
                "update": {"resourceName": resource, "status": ch["desired"]},
                "updateMask": "status",
            }]}
            api_call("POST", "campaigns:mutate", body, customer_id)
            return f"status [{cid}] → {ch['desired']}"
        if ch["field"] == "budget_daily":
            q = f"SELECT campaign_budget.resource_name FROM campaign WHERE campaign.id = {cid}"
            res = api_call("POST", "googleAds:search", {"query": q}, customer_id)
            budget_rn = res["results"][0]["campaignBudget"]["resourceName"]
            micros = int(float(ch["desired"]) * 1_000_000)
            body = {"operations": [{
                "update": {"resourceName": budget_rn, "amountMicros": str(micros)},
                "updateMask": "amount_micros",
            }]}
            api_call("POST", "campaignBudgets:mutate", body, customer_id)
            return f"budget [{cid}] → {ch['desired']}/day"
    if op == "create":
        d = ch["data"]
        if kind == "sitelink":
            body = {"finalUrls": [d["url"]], "sitelinkAsset": {
                "linkText": d["text"],
                "description1": d.get("d1", ""),
                "description2": d.get("d2", ""),
            }}
            rn = _create_asset(body, customer_id)
            _link_to_customer(rn, "SITELINK", customer_id)
            return f"created sitelink '{d['text']}'"
        if kind == "callout":
            rn = _create_asset({"calloutAsset": {"calloutText": d["text"]}}, customer_id)
            _link_to_customer(rn, "CALLOUT", customer_id)
            return f"created callout '{d['text']}'"
        if kind == "snippet":
            rn = _create_asset({"structuredSnippetAsset": {
                "header": d["header"], "values": d["values"]
            }}, customer_id)
            _link_to_customer(rn, "STRUCTURED_SNIPPET", customer_id)
            return f"created snippet '{d['header']}'"
    if op == "prune":
        d = ch["data"]
        # Remove the customer_asset link (asset stays in library; can clean
        # later via `gads cleanup-orphans`).
        ft = {"sitelink": "SITELINK", "callout": "CALLOUT", "snippet": "STRUCTURED_SNIPPET"}[kind]
        resource = f"customers/{customer_id}/customerAssets/{d['id']}~{ft}"
        body = {"operations": [{"remove": resource}]}
        api_call("POST", "customerAssets:mutate", body, customer_id)
        return f"pruned {kind} [{d['id']}]"
    return f"skipped {kind} {op}"


def cmd_sync(args):
    state_file = _load_state_file(args.state_file)
    changes = _compute_diff(state_file, args.customer)

    # Categorise
    applicable, skipped = [], []
    for ch in changes:
        op = ch.get("operation")
        if ch.get("kind") == "campaign" and op == "update":
            applicable.append(ch)
        elif op == "create":
            applicable.append(ch)
        elif op == "prune":
            if getattr(args, "prune", False):
                applicable.append(ch)
            else:
                skipped.append(ch)
        else:
            # missing_in_live / only_in_live for campaigns — informational
            skipped.append(ch)

    if not applicable:
        print("✓ No applicable drift (nothing to sync).")
        if skipped:
            print(f"  {len(skipped)} item(s) skipped (informational or need --prune).")
        return

    print(f"Will apply {len(applicable)} change(s):")
    for ch in applicable:
        print(f"  {_change_summary(ch)}")
    if skipped:
        print(f"\n  {len(skipped)} item(s) skipped:")
        for ch in skipped[:5]:
            print(f"    {_change_summary(ch)}")
        if len(skipped) > 5:
            print(f"    ... and {len(skipped) - 5} more")

    if not args.apply:
        dry_run_banner(f"SYNC {len(applicable)} change(s)", args.state_file)
        return

    print("\nApplying...")
    for ch in applicable:
        try:
            msg = _apply_change(ch, args.customer)
            print(f"  ✓ {msg}")
        except SystemExit as e:
            print(f"  ✗ {ch.get('kind')} {ch.get('operation')} failed (see error above)")
            raise
    print(f"\nSynced. Run `gads plan {args.state_file}` to verify drift is gone.")


# ─── Audit log: one JSON line per --apply mutation ────────────────────────

def _audit_log_path():
    return Path.home() / ".gads" / "audit.log"


def _audit_record(args, status="attempted"):
    """Append one JSON line to ~/.gads/audit.log. Logs regardless of
    success/failure — pair with snapshots to reconstruct what happened."""
    path = _audit_log_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    record = {
        "ts": datetime.datetime.now().isoformat(timespec="seconds"),
        "customer_id": getattr(args, "customer", None),
        "command": args.cmd,
        "status": status,
        "args": {
            k: v for k, v in vars(args).items()
            if not k.startswith("_")
            and k not in ("func", "customer", "cmd", "format", "profile")
            and v not in (None, False)
        },
    }
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(record, default=str, ensure_ascii=False) + "\n")


def cmd_audit_log(args):
    path = _audit_log_path()
    if not path.exists():
        if args.format == "json":
            _emit_json([])
        else:
            print(f"No audit log yet at {path}.")
        return
    lines = path.read_text(encoding="utf-8").splitlines()
    tail = args.tail
    selected = lines[-tail:] if tail > 0 else lines
    parsed = []
    for line in selected:
        try:
            parsed.append(json.loads(line))
        except Exception:
            continue

    if args.format == "json":
        _emit_json(parsed)
        return

    if not parsed:
        print("(empty)")
        return
    print(f"{'WHEN':<20}  {'COMMAND':<22}  {'STATUS':<10}  ARGS")
    print("-" * 110)
    for r in parsed:
        args_str = " ".join(
            f"{k}={v}" for k, v in r.get("args", {}).items()
            if k != "apply"
        ) or "—"
        print(f"{r['ts']:<20}  {r['command']:<22}  {r.get('status','?'):<10}  {args_str[:70]}")


