def _resolve_date_range(args):
    """Returns (start, end) as YYYY-MM-DD strings."""
    today = datetime.date.today()
    if getattr(args, "start", None) and getattr(args, "end", None):
        return args.start, args.end
    days = getattr(args, "days", None) or 30
    end = today - datetime.timedelta(days=1)  # yesterday (today's data incomplete)
    start = end - datetime.timedelta(days=days - 1)
    return start.isoformat(), end.isoformat()


_PERF_FIELDS = [
    "metrics.impressions",
    "metrics.clicks",
    "metrics.cost_micros",
    "metrics.ctr",
    "metrics.average_cpc",
    "metrics.conversions",
    "metrics.conversions_value",
    "metrics.search_impression_share",
    "metrics.search_budget_lost_impression_share",
    "metrics.search_rank_lost_impression_share",
]


def _fetch_campaign_stats(args, start, end):
    """Returns list of {campaign_id, campaign_name, ...metrics}."""
    fields = ["campaign.id", "campaign.name"] + _PERF_FIELDS
    where = [f"segments.date BETWEEN '{start}' AND '{end}'",
             "campaign.status != 'REMOVED'"]
    if getattr(args, "campaign", None):
        where.append(f"campaign.id = {args.campaign}")
    q = f"SELECT {', '.join(fields)} FROM campaign WHERE {' AND '.join(where)}"
    res = api_call("POST", "googleAds:search", {"query": q}, args.customer)
    return res.get("results", [])


def _aggregate(rows):
    """Sum metrics across rows. Returns dict with derived rates."""
    if not rows:
        return None
    agg = {"cost": 0, "imp": 0, "clicks": 0, "conv": 0.0, "conv_value": 0.0}
    # IS metrics are share-of-search-eligible — we average them (approximation;
    # exact aggregation requires impression-weighted, but for a single
    # account-wide reporting view this is close enough).
    is_vals = {"is": [], "lost_b": [], "lost_r": []}
    for row in rows:
        m = row.get("metrics", {})
        agg["cost"] += int(m.get("costMicros", 0))
        agg["imp"] += int(m.get("impressions", 0))
        agg["clicks"] += int(m.get("clicks", 0))
        agg["conv"] += float(m.get("conversions", 0))
        agg["conv_value"] += float(m.get("conversionsValue", 0))
        if "searchImpressionShare" in m: is_vals["is"].append(float(m["searchImpressionShare"]))
        if "searchBudgetLostImpressionShare" in m: is_vals["lost_b"].append(float(m["searchBudgetLostImpressionShare"]))
        if "searchRankLostImpressionShare" in m: is_vals["lost_r"].append(float(m["searchRankLostImpressionShare"]))

    agg["ctr"] = agg["clicks"] / agg["imp"] if agg["imp"] else 0
    agg["cpc"] = agg["cost"] / agg["clicks"] if agg["clicks"] else 0
    agg["roas"] = agg["conv_value"] / (agg["cost"] / 1_000_000) if agg["cost"] else 0
    agg["is"] = sum(is_vals["is"]) / len(is_vals["is"]) if is_vals["is"] else 0
    agg["lost_is_b"] = sum(is_vals["lost_b"]) / len(is_vals["lost_b"]) if is_vals["lost_b"] else 0
    agg["lost_is_r"] = sum(is_vals["lost_r"]) / len(is_vals["lost_r"]) if is_vals["lost_r"] else 0
    return agg


def _fmt_delta(curr, prev, kind="pct"):
    """Return "+12%" / "-3%" / "—" string for delta display."""
    if prev == 0 and curr == 0: return "—"
    if prev == 0: return "+∞" if curr > 0 else "—"
    d = (curr - prev) / abs(prev) * 100
    sign = "+" if d >= 0 else ""
    return f"{sign}{d:.0f}%"


def cmd_stats(args):
    start, end = _resolve_date_range(args)
    rows = _fetch_campaign_stats(args, start, end)
    days = (datetime.date.fromisoformat(end) - datetime.date.fromisoformat(start)).days + 1

    per_campaign = []
    for row in rows:
        c = row["campaign"]
        m = row["metrics"]
        clicks = int(m.get("clicks", 0))
        imp = int(m.get("impressions", 0))
        cost_micros = int(m.get("costMicros", 0))
        conv = float(m.get("conversions", 0))
        cval = float(m.get("conversionsValue", 0))
        per_campaign.append({
            "campaign_id": c["id"],
            "campaign_name": c["name"],
            "cost_units": cost_micros / 1_000_000,
            "impressions": imp,
            "clicks": clicks,
            "ctr": (clicks / imp) if imp else 0,
            "avg_cpc_units": (cost_micros / clicks / 1_000_000) if clicks else 0,
            "conversions": conv,
            "conversions_value": cval,
            "roas": (cval / (cost_micros / 1_000_000)) if cost_micros else 0,
            "search_impression_share":               float(m.get("searchImpressionShare", 0)),
            "search_budget_lost_impression_share":   float(m.get("searchBudgetLostImpressionShare", 0)),
            "search_rank_lost_impression_share":     float(m.get("searchRankLostImpressionShare", 0)),
        })

    totals = _aggregate(rows)
    summary_block = None
    if totals:
        summary_block = {
            "cost_units": totals["cost"] / 1_000_000,
            "impressions": totals["imp"],
            "clicks": totals["clicks"],
            "ctr": totals["ctr"],
            "avg_cpc_units": totals["cpc"] / 1_000_000,
            "conversions": totals["conv"],
            "conversions_value": totals["conv_value"],
            "roas": totals["roas"],
            "search_impression_share":               totals["is"],
            "search_budget_lost_impression_share":   totals["lost_is_b"],
            "search_rank_lost_impression_share":     totals["lost_is_r"],
        }

    if args.format == "json":
        _emit_json({
            "period": {"start": start, "end": end, "days": days},
            "campaigns": per_campaign,
            "totals": summary_block,
        })
        return

    print(f"Period: {start} → {end}  ({days} days)\n")
    if not rows:
        print("No data in this period.")
        return

    print(f"{'CAMPAIGN':<36}  {'COST':>12}  {'IMP':>8}  {'CLK':>6}  {'CTR':>6}  {'CPC':>9}  {'CONV':>6}  {'C.VAL':>10}  {'ROAS':>6}  {'IS%':>6}  {'L-BUD':>6}  {'L-RANK':>7}")
    print("-" * 150)
    for c in per_campaign:
        print(f"{c['campaign_name'][:36]:<36}  {c['cost_units']:>12,.0f}  {c['impressions']:>8,}  {c['clicks']:>6,}  {c['ctr']*100:>5.2f}%  "
              f"{c['avg_cpc_units']:>8,.0f}  {c['conversions']:>6.1f}  {c['conversions_value']:>10,.0f}  {c['roas']:>5.2f}x  "
              f"{c['search_impression_share']*100:>5.1f}%  {c['search_budget_lost_impression_share']*100:>5.1f}%  {c['search_rank_lost_impression_share']*100:>6.1f}%")
    if summary_block and len(per_campaign) > 1:
        s = summary_block
        print("-" * 150)
        print(f"{'TOTAL':<36}  {s['cost_units']:>12,.0f}  {s['impressions']:>8,}  {s['clicks']:>6,}  "
              f"{s['ctr']*100:>5.2f}%  {s['avg_cpc_units']:>8,.0f}  {s['conversions']:>6.1f}  "
              f"{s['conversions_value']:>10,.0f}  {s['roas']:>5.2f}x  "
              f"{s['search_impression_share']*100:>5.1f}%  {s['search_budget_lost_impression_share']*100:>5.1f}%  {s['search_rank_lost_impression_share']*100:>6.1f}%")


def cmd_stats_vs_prev(args):
    today = datetime.date.today()
    end_curr = today - datetime.timedelta(days=1)
    start_curr = end_curr - datetime.timedelta(days=args.days - 1)
    end_prev = start_curr - datetime.timedelta(days=1)
    start_prev = end_prev - datetime.timedelta(days=args.days - 1)

    curr_args = argparse.Namespace(customer=args.customer, campaign=args.campaign,
                                    start=start_curr.isoformat(), end=end_curr.isoformat())
    prev_args = argparse.Namespace(customer=args.customer, campaign=args.campaign,
                                    start=start_prev.isoformat(), end=end_prev.isoformat())
    curr = _aggregate(_fetch_campaign_stats(curr_args, str(start_curr), str(end_curr)))
    prev = _aggregate(_fetch_campaign_stats(prev_args, str(start_prev), str(end_prev)))

    if not curr and args.format != "json":
        print("No data in the current period.")
        return
    if not prev:
        prev = {k: 0 for k in (curr or {})}

    metrics = [
        ("spend_units",                          curr.get("cost", 0)/1_000_000      if curr else 0,  prev["cost"]/1_000_000,    "{:,.0f}"),
        ("impressions",                          curr.get("imp", 0)                  if curr else 0,  prev["imp"],               "{:,}"),
        ("clicks",                               curr.get("clicks", 0)               if curr else 0,  prev["clicks"],            "{:,}"),
        ("ctr_pct",                              (curr.get("ctr", 0) or 0)*100       if curr else 0,  prev["ctr"]*100,           "{:.2f}"),
        ("avg_cpc_units",                        curr.get("cpc", 0)/1_000_000        if curr else 0,  prev["cpc"]/1_000_000,     "{:,.0f}"),
        ("conversions",                          curr.get("conv", 0)                 if curr else 0,  prev["conv"],              "{:.1f}"),
        ("conv_value_units",                     curr.get("conv_value", 0)           if curr else 0,  prev["conv_value"],        "{:,.0f}"),
        ("roas",                                 curr.get("roas", 0)                 if curr else 0,  prev["roas"],              "{:.2f}x"),
        ("search_impression_share_pct",          (curr.get("is", 0) or 0)*100        if curr else 0,  prev["is"]*100,            "{:.1f}"),
        ("lost_is_budget_pct",                   (curr.get("lost_is_b", 0) or 0)*100 if curr else 0,  prev["lost_is_b"]*100,     "{:.1f}"),
        ("lost_is_rank_pct",                     (curr.get("lost_is_r", 0) or 0)*100 if curr else 0,  prev["lost_is_r"]*100,     "{:.1f}"),
    ]

    if args.format == "json":
        _emit_json({
            "period_current":  {"start": start_curr.isoformat(), "end": end_curr.isoformat(), "days": args.days},
            "period_previous": {"start": start_prev.isoformat(), "end": end_prev.isoformat(), "days": args.days},
            "metrics": [{"key": k, "current": c, "previous": p,
                         "delta_pct": ((c - p) / abs(p) * 100) if p else None}
                        for k, c, p, _ in metrics],
        })
        return

    print(f"Current {args.days} days:  {start_curr} → {end_curr}")
    print(f"Previous {args.days} days: {start_prev} → {end_prev}\n")
    print(f"{'METRIC':<22}  {'CURR':>14}  {'PREV':>14}  {'Δ':>8}")
    print("-" * 65)
    labels = {
        "spend_units": "Spend (units)", "impressions": "Impressions", "clicks": "Clicks",
        "ctr_pct": "CTR (%)", "avg_cpc_units": "Avg CPC (units)",
        "conversions": "Conversions", "conv_value_units": "Conv. value",
        "roas": "ROAS", "search_impression_share_pct": "Search IS (%)",
        "lost_is_budget_pct": "Lost IS budget (%)", "lost_is_rank_pct": "Lost IS rank (%)",
    }
    for key, c, p, fmt in metrics:
        label = labels.get(key, key)
        print(f"{label:<22}  {fmt.format(c):>14}  {fmt.format(p):>14}  {_fmt_delta(c, p):>8}")


