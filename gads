def cmd_list_profiles(args):
    pdir = _GADS_CONFIG_DIR / "profiles"
    if not pdir.exists():
        print(f"No profiles directory yet at {pdir}")
        print(f"Create one: mkdir -p {pdir} && put <name>.toml files in it.")
        return
    default = _load_global_config().get("default_profile")
    print(f"{'NAME':<24}  {'CUSTOMER_ID':<14}  {'DEFAULT':<8}  PACKS ROOT")
    print("-" * 100)
    for path in sorted(pdir.glob("*.toml")):
        try:
            with open(path, "rb") as f:
                p = tomllib.load(f)
        except Exception as e:
            print(f"{path.stem:<24}  [parse error: {e}]")
            continue
        name = path.stem
        is_default = "✓" if name == default else ""
        print(f"{name:<24}  {p.get('customer_id', '—'):<14}  {is_default:<8}  {p.get('packs_root', '')}")


