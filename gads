# ─── Orphan cleanup ───────────────────────────────────────────────────────

def _orphan_budgets(customer_id):
    """Return list of (budget_id, name) for campaign budgets with no
    non-removed campaign referencing them (reference_count == 0)."""
    q = """
    SELECT
      campaign_budget.id, campaign_budget.name,
      campaign_budget.reference_count, campaign_budget.amount_micros
    FROM campaign_budget
    WHERE campaign_budget.status != 'REMOVED'
    """
    res = api_call("POST", "googleAds:search", {"query": q}, customer_id)
    out = []
    for row in res.get("results", []):
        cb = row["campaignBudget"]
        # reference_count comes back as a string in REST JSON
        if int(cb.get("referenceCount", "0")) == 0:
            out.append((cb["id"], cb.get("name", "(unnamed)"), int(cb.get("amountMicros", "0"))))
    return out


def _orphan_text_assets(customer_id, limit=500):
    """Return list of (asset_id, text) for TEXT assets with no current
    asset_group_asset, customer_asset, or campaign_asset link."""
    # Pull all live assets of type TEXT
    q_assets = f"""
    SELECT asset.id, asset.text_asset.text
    FROM asset
    WHERE asset.type = 'TEXT'
    LIMIT {limit}
    """
    res = api_call("POST", "googleAds:search", {"query": q_assets}, customer_id)
    all_text = {row["asset"]["id"]: row["asset"]["textAsset"]["text"]
                for row in res.get("results", [])}
    if not all_text:
        return []

    # Pull live linked-asset IDs across the three link tables
    linked = set()
    for resource in ("asset_group_asset", "customer_asset", "campaign_asset"):
        q = f"""
        SELECT asset.id
        FROM {resource}
        WHERE {resource}.status != 'REMOVED'
        """
        try:
            res = api_call("POST", "googleAds:search", {"query": q}, customer_id)
            for row in res.get("results", []):
                linked.add(row["asset"]["id"])
        except SystemExit:
            # Some link resources require extra fields; ignore and proceed
            pass

    return [(aid, text) for aid, text in all_text.items() if aid not in linked]


def cmd_cleanup_orphans(args):
    target = args.type.lower()
    if target not in ("budget", "asset", "all"):
        sys.exit(f"ERROR: --type must be one of: budget, asset, all")

    budgets, assets = [], []
    if target in ("budget", "all"):
        print("Scanning for orphan campaign budgets...")
        budgets = _orphan_budgets(args.customer)
        print(f"  Found {len(budgets)} orphan budget(s).\n")
        for bid, name, micros in budgets:
            print(f"    {bid}  {micros_to_units(micros):>10} /day  {name}")

    if target in ("asset", "all"):
        print("\nScanning for orphan text assets...")
        assets = _orphan_text_assets(args.customer)
        print(f"  Found {len(assets)} orphan text asset(s).\n")
        for aid, text in assets[:50]:
            preview = text[:60] + ("..." if len(text) > 60 else "")
            print(f"    {aid:>14}  {preview}")
        if len(assets) > 50:
            print(f"    ... and {len(assets) - 50} more")
        if assets:
            print("\n  ⚠️  This scan checks asset_group_asset, customer_asset, and")
            print("      campaign_asset link tables. Text assets used inside RSA")
            print("      headlines/descriptions are linked via ad_group_ad_asset_view")
            print("      and may show as orphan here even though Google references")
            print("      them. If you see RSA copy in this list, the API will refuse")
            print("      to delete an in-use asset (RESOURCE_IN_USE) — safe to try.")

    total = len(budgets) + len(assets)
    if total == 0:
        print("\n✓ No orphans found.")
        return

    if not args.apply:
        dry_run_banner(f"DELETE {len(budgets)} budget(s) + {len(assets)} asset(s)", str(args.customer))
        return

    print(f"\nDeleting {total} orphan resource(s)...")
    if budgets:
        ops = [{"remove": f"customers/{args.customer}/campaignBudgets/{b[0]}"} for b in budgets]
        api_call("POST", "campaignBudgets:mutate", {"operations": ops}, args.customer)
        print(f"  ✓ {len(budgets)} budget(s) deleted")

    if assets:
        # Delete in batches of 100 to stay under API operation limits
        for i in range(0, len(assets), 100):
            batch = assets[i:i+100]
            ops = [{"remove": f"customers/{args.customer}/assets/{a[0]}"} for a in batch]
            api_call("POST", "assets:mutate", {"operations": ops}, args.customer)
        print(f"  ✓ {len(assets)} asset(s) deleted")

    print("\nDone. Re-run `gads cleanup-orphans` to verify.")


