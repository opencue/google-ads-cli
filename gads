def _create_text_asset(text, customer_id):
    body = {"operations": [{"create": {"textAsset": {"text": text}}}]}
    res = api_call("POST", "assets:mutate", body, customer_id)
    return res["results"][0]["resourceName"]


def _create_image_asset(file_path, customer_id, name=None):
    """Upload binary image as IMAGE asset. Returns asset resource name."""
    with open(file_path, "rb") as f:
        data = f.read()
    b64 = base64.b64encode(data).decode("ascii")
    asset_body = {"type": "IMAGE", "imageAsset": {"data": b64}}
    if name:
        asset_body["name"] = name
    body = {"operations": [{"create": asset_body}]}
    res = api_call("POST", "assets:mutate", body, customer_id)
    return res["results"][0]["resourceName"]


def _link_asset_to_group(asset_resource, asset_group_id, field_type, customer_id):
    asset_group_rn = f"customers/{customer_id}/assetGroups/{asset_group_id}"
    body = {"operations": [{"create": {
        "assetGroup": asset_group_rn,
        "asset": asset_resource,
        "fieldType": field_type,
    }}]}
    api_call("POST", "assetGroupAssets:mutate", body, customer_id)


def _link_asset_to_campaign(asset_resource, campaign_id, field_type, customer_id):
    """For PMAX with Brand Guidelines enabled: BUSINESS_NAME and LOGO must
    link at the campaign level (not asset group)."""
    campaign_rn = f"customers/{customer_id}/campaigns/{campaign_id}"
    body = {"operations": [{"create": {
        "campaign": campaign_rn,
        "asset": asset_resource,
        "fieldType": field_type,
    }}]}
    api_call("POST", "campaignAssets:mutate", body, customer_id)


def _campaign_for_asset_group(asset_group_id, customer_id):
    """Look up the parent campaign for an asset group."""
    q = f"SELECT asset_group.campaign FROM asset_group WHERE asset_group.id = {asset_group_id}"
    res = api_call("POST", "googleAds:search", {"query": q}, customer_id)
    if not res.get("results"):
        sys.exit(f"ERROR: asset group {asset_group_id} nem található")
    return res["results"][0]["assetGroup"]["campaign"].rsplit("/", 1)[-1]


# Field types that must link at campaign level when PMAX Brand Guidelines is on.
CAMPAIGN_LEVEL_BRAND_FIELDS = {"BUSINESS_NAME", "LOGO", "LANDSCAPE_LOGO"}


def _smart_link(asset_resource, asset_group_id, field_type, customer_id, reuse_existing=None):
    """Link an asset using the right endpoint: campaign for BUSINESS_NAME/LOGO
    under Brand Guidelines, asset group for everything else.
    `reuse_existing` is an optional asset resource we'd link instead of the
    newly created one (for orphan recovery)."""
    rn = reuse_existing or asset_resource
    if field_type in CAMPAIGN_LEVEL_BRAND_FIELDS:
        campaign_id = _campaign_for_asset_group(asset_group_id, customer_id)
        _link_asset_to_campaign(rn, campaign_id, field_type, customer_id)
        return f"campaign {campaign_id}"
    _link_asset_to_group(rn, asset_group_id, field_type, customer_id)
    return f"asset group {asset_group_id}"


