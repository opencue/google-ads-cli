def cmd_create_brand_campaign(args):
    profile = _load_profile(args.profile)
    pack = _load_pack(args.pack, profile)

    name = pack.get("name") or "Brand Search"
    final_url = pack.get("final_url")
    if not final_url:
        sys.exit("ERROR: pack must define 'final_url'")
    daily = float(pack.get("daily_budget") or 0)
    if daily <= 0:
        sys.exit("ERROR: pack must define 'daily_budget' > 0")
    bidding = (pack.get("bidding_strategy") or "MAXIMIZE_CONVERSIONS").upper()
    status = (pack.get("status_on_create") or "PAUSED").upper()
    ag_bid_units = int(pack.get("ad_group_bid") or 200)

    keywords = pack.get("keywords") or []
    headlines = pack.get("headlines") or []
    descriptions = pack.get("descriptions") or []
    if not keywords:
        sys.exit("ERROR: pack must define [[keywords]] (at least 1)")
    if len(headlines) < 3:
        sys.exit("ERROR: RSA needs ≥3 headlines")
    if len(descriptions) < 2:
        sys.exit("ERROR: RSA needs ≥2 descriptions")

    for h in headlines:
        if _google_width(h) > 30:
            sys.exit(f"ERROR: RSA headline '{h}' Google-width > 30")
    for d in descriptions:
        if _google_width(d) > 90:
            sys.exit(f"ERROR: RSA description '{d}' Google-width > 90")

    # Geo targets from profile.locale (list of geoTargetConstant integer IDs)
    geo_ids = (profile or {}).get("locale", {}).get("geo_targets") or []

    print(f"Brand Search campaign plan:\n")
    print(f"  Name:          {name}")
    print(f"  Budget:        {daily:,.0f}/day  (account currency)")
    print(f"  Bidding:       {bidding}")
    print(f"  Channel:       SEARCH (Google Search only — Search Network OFF)")
    print(f"  Status:        {status}")
    print(f"  Geo targets:   {geo_ids if geo_ids else '(none — campaign will serve everywhere)'}")
    print(f"  Final URL:     {final_url}\n")
    print(f"  Keywords ({len(keywords)}):")
    for kw in keywords:
        print(f"    • [{kw['match_type']:<7}] {kw['text']}")
    print(f"\n  RSA headlines ({len(headlines)}):")
    for h in headlines:
        print(f"    • ({_google_width(h):>2}) {h}")
    print(f"\n  RSA descriptions ({len(descriptions)}):")
    for d in descriptions:
        print(f"    • ({_google_width(d):>2}) {d}")

    if not args.apply:
        dry_run_banner("CREATE BRAND SEARCH CAMPAIGN", name)
        return

    cid = args.customer

    print("\n[1/6] Campaign budget...")
    micros = int(daily * 1_000_000)
    budget_op = {"create": {
        "name": f"{name} — budget",
        "amountMicros": str(micros),
        "deliveryMethod": "STANDARD",
        "explicitlyShared": False,
    }}
    res = api_call("POST", "campaignBudgets:mutate", {"operations": [budget_op]}, cid)
    budget_rn = res["results"][0]["resourceName"]
    print(f"  ✓ {budget_rn}")

    print(f"\n[2/6] Campaign (SEARCH, {bidding}, {status})...")
    bidding_field = {
        "MAXIMIZE_CONVERSIONS": ("maximizeConversions", {}),
        "MAXIMIZE_CONVERSION_VALUE": ("maximizeConversionValue", {}),
        "MANUAL_CPC": ("manualCpc", {"enhancedCpcEnabled": False}),
    }.get(bidding)
    if not bidding_field:
        sys.exit(f"ERROR: unsupported bidding_strategy '{bidding}'")
    campaign_op = {"create": {
        "name": name,
        "status": status,
        "advertisingChannelType": "SEARCH",
        bidding_field[0]: bidding_field[1],
        "campaignBudget": budget_rn,
        "containsEuPoliticalAdvertising": "DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING",
        "networkSettings": {
            "targetGoogleSearch": True,
            "targetSearchNetwork": False,
            "targetContentNetwork": False,
            "targetPartnerSearchNetwork": False,
        },
    }}
    res = api_call("POST", "campaigns:mutate", {"operations": [campaign_op]}, cid)
    campaign_rn = res["results"][0]["resourceName"]
    print(f"  ✓ {campaign_rn}")

    print(f"\n[3/6] Geo targeting...")
    if geo_ids:
        geo_ops = [{"create": {
            "campaign": campaign_rn,
            "location": {"geoTargetConstant": f"geoTargetConstants/{g}"},
        }} for g in geo_ids]
        api_call("POST", "campaignCriteria:mutate", {"operations": geo_ops}, cid)
        print(f"  ✓ {len(geo_ids)} geo target hozzáadva")
    else:
        print(f"  — no geo_targets in profile, skipping")

    print("\n[4/6] Ad group...")
    ad_group_op = {"create": {
        "name": f"{name} — Brand",
        "campaign": campaign_rn,
        "type": "SEARCH_STANDARD",
        "status": "ENABLED",
        "cpcBidMicros": str(ag_bid_units * 1_000_000),
    }}
    res = api_call("POST", "adGroups:mutate", {"operations": [ad_group_op]}, cid)
    ad_group_rn = res["results"][0]["resourceName"]
    print(f"  ✓ {ad_group_rn}")

    print(f"\n[5/6] {len(keywords)} keywords...")
    kw_ops = [{"create": {
        "adGroup": ad_group_rn,
        "status": "ENABLED",
        "keyword": {"text": kw["text"], "matchType": kw["match_type"]},
    }} for kw in keywords]
    api_call("POST", "adGroupCriteria:mutate", {"operations": kw_ops}, cid)
    print(f"  ✓ {len(keywords)} keywords added")

    print("\n[6/6] Responsive Search Ad...")
    rsa_op = {"create": {
        "adGroup": ad_group_rn,
        "status": "ENABLED",
        "ad": {
            "finalUrls": [final_url],
            "responsiveSearchAd": {
                "headlines": [{"text": h} for h in headlines],
                "descriptions": [{"text": d} for d in descriptions],
            },
        },
    }}
    api_call("POST", "adGroupAds:mutate", {"operations": [rsa_op]}, cid)
    print(f"  ✓ RSA created")

    print(f"\nDone. Campaign is {status} — review and enable manually if needed.")
    print(f"Campaign ID: {campaign_rn.rsplit('/',1)[-1]}")


def _check_url(url):
    """HEAD-fallback-GET to check a URL returns 2xx. Returns status code or 0."""
    for method in ("HEAD", "GET"):
        try:
            req = urllib.request.Request(url, method=method,
                                         headers={"User-Agent": "gads-cli/1.0"})
            with urllib.request.urlopen(req, timeout=5) as resp:
                return resp.status
        except urllib.error.HTTPError as e:
            return e.code
        except Exception:
            continue
    return 0


def cmd_seed_account_assets(args):
    pack = _load_pack(args.pack, _load_profile(args.profile))
    sitelinks = pack.get("sitelinks", [])
    callouts = pack.get("callouts", [])
    snippets = pack.get("snippets", [])

    existing = _existing_account_assets(args.customer)
    has_any = any(
        existing.get(ft, 0) > 0
        for ft in ("SITELINK", "CALLOUT", "STRUCTURED_SNIPPET")
    )
    if has_any and not args.force:
        print("⚠️  Already account-level assets in this account:")
        for ft in ("SITELINK", "CALLOUT", "STRUCTURED_SNIPPET"):
            n = existing.get(ft, 0)
            if n:
                print(f"     {ft}: {n}")
        print("\nUse --force to seed anyway (will duplicate).")
        print("Or inspect existing: gads list-account-assets")
        return

    print(f"Planned changes for customer {args.customer} (pack: {args.pack}):\n")
    print(f"  {len(sitelinks)} SITELINK:")
    broken_urls = []
    for sl in sitelinks:
        code = _check_url(sl["url"])
        flag = "✓" if 200 <= code < 300 else f"✗ HTTP {code}"
        if not (200 <= code < 300):
            broken_urls.append((sl["text"], sl["url"], code))
        print(f"    {flag}  {sl['text']:<22}  → {sl['url']}")
        print(f"          d1: {sl.get('d1', '')}")
        print(f"          d2: {sl.get('d2', '')}")
    if broken_urls and not args.skip_url_check:
        print(f"\n  ⚠️  {len(broken_urls)} URL not 2xx — Google Ads will disapprove.")
        print(f"     Fix the pack, or pass --skip-url-check.")

    print(f"\n  {len(callouts)} CALLOUT:")
    for c in callouts:
        print(f"    • {c}  ({len(c)} chars)")

    print(f"\n  {len(snippets)} STRUCTURED_SNIPPET:")
    for s in snippets:
        print(f"    • {s['header']}: {', '.join(s['values'])}")

    if not args.apply:
        dry_run_banner(f"SEED {len(sitelinks)}+{len(callouts)}+{len(snippets)} account-level asset", args.customer)
        return

    if broken_urls and not args.skip_url_check:
        sys.exit("\n❌ Refusing to run — broken URLs. Add --skip-url-check to override.")

    print("\nExecuting...")
    for sl in sitelinks:
        body = {
            "finalUrls": [sl["url"]],
            "sitelinkAsset": {
                "linkText": sl["text"],
                "description1": sl.get("d1", ""),
                "description2": sl.get("d2", ""),
            },
        }
        r = _create_asset(body, args.customer)
        _link_to_customer(r, "SITELINK", args.customer)
        print(f"  ✓ sitelink  {sl['text']:<22}  → {r.rsplit('/', 1)[-1]}")

    for c in callouts:
        r = _create_asset({"calloutAsset": {"calloutText": c}}, args.customer)
        _link_to_customer(r, "CALLOUT", args.customer)
        print(f"  ✓ callout   {c:<26}  → {r.rsplit('/', 1)[-1]}")

    for s in snippets:
        r = _create_asset({"structuredSnippetAsset": {"header": s["header"], "values": s["values"]}}, args.customer)
        _link_to_customer(r, "STRUCTURED_SNIPPET", args.customer)
        print(f"  ✓ snippet   {s['header']:<26}  → {r.rsplit('/', 1)[-1]}")

    print("\nDone. Verify: gads list-account-assets")


