def cmd_list_campaigns(args):
    q = """
    SELECT
      campaign.id, campaign.name, campaign.status,
      campaign.advertising_channel_type, campaign.bidding_strategy_type,
      campaign.url_expansion_opt_out, campaign_budget.amount_micros
    FROM campaign
    WHERE campaign.status != 'REMOVED'
    ORDER BY campaign.status, campaign.id
    """
    res = api_call("POST", "googleAds:search", {"query": q}, args.customer)
    print(f"{'ID':>12}  {'STATUS':<10}  {'TYPE':<18}  {'BID':<27}  {'BUDGET':<14}  {'URL EXP':<9}  NAME")
    print("-" * 130)
    for row in res.get("results", []):
        c = row["campaign"]
        cb = row.get("campaignBudget", {})
        url_exp = "OFF" if c.get("urlExpansionOptOut") else "ON"
        print(f"{c['id']:>12}  {c['status']:<10}  {c['advertisingChannelType']:<18}  "
              f"{c.get('biddingStrategyType', '-'):<27}  "
              f"{micros_to_units(cb.get('amountMicros')):<14}  "
              f"{url_exp:<9}  {c['name']}")


