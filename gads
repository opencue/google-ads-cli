def cmd_commands(args):
    out = {
        "version": "1.0",
        "global_args": [
            {"name": "--customer",  "description": "Override profile's customer_id"},
            {"name": "--profile",   "description": "Profile name from ~/.config/gads/profiles/"},
            {"name": "--format",    "description": "table (default) or json"},
        ],
        "auth": {
            "method": "gcloud ADC + developer token env var",
            "required_env": ["GOOGLE_ADS_DEVELOPER_TOKEN"],
            "optional_env": ["GOOGLE_ADS_LOGIN_CUSTOMER_ID", "GADS_PROFILE"],
            "preflight": "gcloud auth application-default print-access-token",
        },
        "safety": {
            "default_mode": "dry-run for all mutating commands",
            "commit_flag": "--apply",
        },
        "commands": [
            {
                "name": name,
                "category": category,
                "mutating": mutates,
                "description": desc,
                "example": example,
            }
            for (name, category, mutates, desc, example) in _COMMANDS_MANIFEST
        ],
    }
    # `commands` is always JSON regardless of --format. It's a discovery API.
    _emit_json(out)


